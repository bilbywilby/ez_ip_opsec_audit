## Additional Deliverable #6: Handover Success Metrics Framework

```python
"""
Handover Success Measurement Framework
Define and track KPIs for handover quality
"""

from dataclasses import dataclass
from enum import Enum
from typing import Dict, List
from datetime import datetime

class MetricCategory(Enum):
    TECHNICAL = "technical"
    OPERATIONAL = "operational"
    KNOWLEDGE = "knowledge"
    BUSINESS = "business"

@dataclass
class HandoverMetric:
    name: str
    category: MetricCategory
    target: float
    current: float
    weight: float  # Importance weight (1-5)
    measured_at: str

class HandoverScorecard:
    """Track and score handover success across multiple dimensions"""
    
    def __init__(self):
        self.metrics: List[HandoverMetric] = []
    
    def add_metric(self, metric: HandoverMetric):
        self.metrics.append(metric)
    
    def calculate_score(self) -> Dict:
        """Calculate weighted success score"""
        total_weight = sum(m.weight for m in self.metrics)
        weighted_sum = 0
        
        for metric in self.metrics:
            score_ratio = min(1.0, metric.current / metric.target) if metric.target > 0 else 1.0
            weighted_sum += score_ratio * metric.weight
        
        overall_score = (weighted_sum / total_weight) * 100
        
        return {
            "overall_score": round(overall_score, 1),
            "metrics_breakdown": [
                {
                    "name": m.name,
                    "category": m.category.value,
                    "target": m.target,
                    "current": m.current,
                    "percent_complete": round((min(1.0, m.current / m.target) if m.target > 0 else 1.0) * 100, 1),
                    "weight": m.weight,
                    "status": "✅" if m.current >= m.target else "⚠️"
                }
                for m in self.metrics
            ],
            "category_scores": self._calculate_category_scores(),
            "assessed_at": datetime.utcnow().isoformat()
        }
    
    def _calculate_category_scores(self) -> Dict[str, float]:
        """Average scores by category"""
        categories = {}
        
        for category in MetricCategory:
            cat_metrics = [m for m in self.metrics if m.category == category]
            if cat_metrics:
                avg = sum(m.current / m.target for m in cat_metrics) / len(cat_metrics)
                categories[category.value] = round(avg * 100, 1)
        
        return categories
    
    def generate_grade(self) -> str:
        """Assign letter grade based on score"""
        score = self.calculate_score()["overall_score"]
        
        if score >= 95:
            return "A+"
        elif score >= 90:
            return "A"
        elif score >= 85:
            return "A-"
        elif score >= 80:
            return "B+"
        elif score >= 75:
            return "B"
        elif score >= 70:
            return "B-"
        elif score >= 65:
            return "C+"
        elif score >= 60:
            return "C"
        else:
            return "F"

def create_default_scorecard() -> HandoverScorecard:
    """Create scorecard with standard handover metrics"""
    scorecard = HandoverScorecard()
    
    scorecard.add_metric(HandoverMetric(
        name="Documentation Completeness",
        category=MetricCategory.KNOWLEDGE,
        target=100,
        current=85,
        weight=4
    ))
    
    scorecard.add_metric(HandoverMetric(
        name="Training Completion Rate",
        category=MetricCategory.KNOWLEDGE,
        target=100,
        current=75,
        weight=5
    ))
    
    scorecard.add_metric(HandoverMetric(
        name="Credentials Rotated",
        category=MetricCategory.TECHNICAL,
        target=100,
        current=0,
        weight=5
    ))
    
    scorecard.add_metric(HandoverMetric(
        name="Access Transferred",
        category=MetricCategory.TECHNICAL,
        target=100,
        current=60,
        weight=4
    ))
    
    scorecard.add_metric(HandoverMetric(
        name="Incident Response Independence",
        category=MetricCategory.OPERATIONAL,
        target=100,
        current=50,
        weight=5
    ))
    
    scorecard.add_metric(HandoverMetric(
        name="Contract Transfer Complete",
        category=MetricCategory.BUSINESS,
        target=100,
        current=40,
        weight=3
    ))
    
    return scorecard

if __name__ == "__main__":
    scorecard = create_default_scorecard()
    results = scorecard.calculate_score()
    grade = scorecard.generate_grade()
    
    print(f"Handover Success Grade: {grade}")
    print(f"Overall Score: {results['overall_score']:.1f}%")
    print(f"\nCategory Breakdown:")
    for cat, score in results['category_scores'].items():
        print(f"  {cat.upper()}: {score:.1f}%")
```

