### File 13: `prometheus/alert_rules.yml` (Alert Rules)

```yaml
# prometheus/alert_rules.yml
groups:
  - name: security-audit-alerts
    rules:
      # Critical findings threshold
      - alert: CriticalFindingsDetected
        expr: security_open_critical_findings > 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Critical security findings require immediate attention"
          description: "{{ $value }} critical findings detected in last audit"
          
      # High error rate
      - alert: HighErrorRate
        expr: rate(dashboard_api_requests_total{status_code=~"5.."}[5m]) > 0.05
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High API error rate detected"
          description: "Error rate is {{ $value | humanizePercentage }} over last 5 minutes"
          
      # Audit job failures
      - alert: AuditJobFailure
        expr: rate(security_audit_runs_total{status="failure"}[1h]) > 0
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Audit job continuously failing"
          description: "Audit failures detected: {{ $value }} per minute"
          
      # Slow audit execution
      - alert: AuditExecutionSlow
        expr: histogram_quantile(0.95, rate(security_audit_duration_seconds_bucket[1h])) > 600
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Audit execution taking unusually long"
          description: "P95 audit duration is {{ $value }} seconds"
          
      # Low disk space (affects log storage)
      - alert: LowDiskSpace
        expr: (node_filesystem_avail_bytes / node_filesystem_size_bytes) * 100 < 15
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on audit server"
          description: "Disk usage at {{ printf \"%.1f%%\" ((1 - (1 - $value / 100)) * 100) }} available"
          
      # Database connection issues
      - alert: DatabaseConnectionFailures
        expr: rate(database_errors_total[5m]) > 0
        labels:
          severity: critical
        annotations:
          summary: "Database connection errors detected"
          description: "{{ $value }} errors per second"
