# .github/workflows/ci-cd.yml
name: Security Audit Platform - CI/CD

on:
  push:
    branches: [main, develop]
    tags: ['v*']
  pull_request:
    branches: [main]
  schedule:
    - cron: '0 6 * * 1'  # Weekly scan every Monday at 6 AM

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}/security-audit-platform
  PYTHON_VERSION: '3.11'

jobs:
  # -------------------------------------------------------------------
  # CODE QUALITY & SECURITY SCAN
  # -------------------------------------------------------------------
  lint-security:
    name: 🔒 Lint & Security Scan
    runs-on: ubuntu-latest
    timeout-minutes: 15
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flake8 black mypy bandit safety
          
      - name: Lint with flake8
        run: |
          flake8 src/ --count --select=E9,F63,F7,F82 --show-source --statistics
          flake8 src/ --count --exit-zero --max-complexity=10 --max-line-length=127
        
      - name: Black format check
        run: |
          black --check --diff src/
          
      - name: Type checking with mypy
        run: |
          mypy src/ --ignore-missing-imports --no-error-summary || true
      
      - name: Bandit security scan
        run: |
          bandit -r src/ -f json -o bandit-results.json || true
        
      - name: Upload security scan results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: security-scan-results
          path: bandit-results.json
          retention-days: 90
  
  # -------------------------------------------------------------------
  # DEPENDENCY VULNERABILITY SCANNING
  # -------------------------------------------------------------------
  dependency-scan:
    name: 📦 Dependency Vulnerability Check
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
      
      - name: Install requirements
        run: pip install -r requirements.txt
      
      - name: Safety vulnerability check
        run: |
          safety check -r requirements.txt --json > safety-report.json || true
      
      - name: Upload dependency report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: dependency-vulnerabilities
          path: safety-report.json
  
  # -------------------------------------------------------------------
  # UNIT & INTEGRATION TESTS
  # -------------------------------------------------------------------
  test:
    name: 🧪 Run Tests
    runs-on: ubuntu-latest
    needs: [lint-security, dependency-scan]
    timeout-minutes: 30
    
    strategy:
      matrix:
        python-version: ['3.9', '3.10', '3.11']
    
    services:
      redis:
        image: redis:7-alpine
        ports:
          - 6379:6379
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      
      - name: Install test dependencies
        run: |
          pip install -r requirements.txt
          pip install pytest pytest-cov pytest-xdist Faker
      
      - name: Run unit tests with coverage
        run: |
          pytest src/tests/unit \
            --cov=src \
            --cov-report=xml \
            --cov-report=html \
            -v
      
      - name: Run integration tests
        run: |
          pytest src/tests/integration \
            -v \
            --junitxml=junit-results.xml
      
      - name: Upload coverage report
        uses: codecov/codecov-action@v3
        with:
          file: ./coverage.xml
          flags: unittests
          name: codecov-${{ matrix.python-version }}
      
      - name: Upload test results
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ matrix.python-version }}
          path: junit-results.xml
  
  # -------------------------------------------------------------------
  # BUILD & PUSH DOCKER IMAGES
  # -------------------------------------------------------------------
