#!/usr/bin/env python3
"""
Prometheus metrics collection for monitoring
"""

from prometheus_client import Counter, Histogram, Gauge, generate_latest, CollectorRegistry
from flask import Response
from functools import wraps
import time
import logging

logger = logging.getLogger(__name__)

# -------------------------------------------------------------------
# METRIC DEFINITIONS
# -------------------------------------------------------------------
# Counters (cumulative, never decrease)
AUDIT_RUN_COUNT = Counter(
    'security_audit_runs_total',
    'Total number of security audit executions',
    ['status']  # success, failure
)

FINDINGS_COUNT = Counter(
    'security_audit_findings_total',
    'Total security findings detected',
    ['severity', 'type']
)

API_REQUEST_COUNT = Counter(
    'dashboard_api_requests_total',
    'Total API requests to dashboard',
    ['endpoint', 'method', 'status_code']
)

NOTIFICATION_SENT = Counter(
    'alerts_notifications_sent_total',
    'Total notifications sent',
    ['channel', 'severity', 'status']
)

# Gauges (current state, can increase/decrease)
ACTIVE_AUDITS_GAUGE = Gauge(
    'security_active_audits',
    'Currently running audit jobs'
)

OPEN_CRITICAL_FINDINGS = Gauge(
    'security_open_critical_findings',
    'Number of unresolved critical findings'
)

DATABASE_CONNECTIONS = Gauge(
    'database_connections_current',
    'Active database connections'
)

# Histograms (distribution measurements)
AUDIT_DURATION_HISTOGRAM = Histogram(
    'security_audit_duration_seconds',
    'Duration of security audit runs',
    buckets=(10, 30, 60, 120, 300, 600, float('inf'))
)

API_RESPONSE_TIME_HISTOGRAM = Histogram(
    'dashboard_api_response_time_seconds',
    'Dashboard API response times',
    buckets=(0.01, 0.05, 0.1, 0.25, 0.5, 1, 2.5, float('inf'))
)

ERROR_RATE_GAUGE = Gauge(
    'system_error_rate_percentage',
    'Current error rate percentage',
    ['component']
)

# -------------------------------------------------------------------
# DECORATORS
# -------------------------------------------------------------------
def track_audit_runtime(f):
    """Track audit execution time"""
    @wraps(f)
    def wrapper(*args, **kwargs):
        ACTIVE_AUDITS_GAUGE.inc()
        start_time = time.time()
        
        try:
            result = f(*args, **kwargs)
            AUDIT_RUN_COUNT.labels(status='success').inc()
            return result
        except Exception as e:
            AUDIT_RUN_COUNT.labels(status='failure').inc()
            raise
        finally:
            duration = time.time() - start_time
            AUDIT_DURATION_HISTOGRAM.observe(duration)
            ACTIVE_AUDITS_GAUGE.dec()
    
    return wrapper

def track_api_metrics(endpoint_name):
    """Track API endpoint metrics"""
    def decorator(f):
        @wraps(f)
        def wrapper(*args, **kwargs):
            start_time = time.time()
            
            try:
                response = f(*args, **kwargs)
                status_code = response.status_code if hasattr(response, 'status_code') else 200
            except Exception:
                status_code = 500
            
            API_REQUEST_COUNT.labels(
                endpoint=endpoint_name,
                method='GET' if hasattr(f, '_method') else 'POST',
                status_code=status_code
            ).inc()
            
            duration = time.time() - start_time
            API_RESPONSE_TIME_HISTOGRAM.observe(duration)
            
            return response
        
        return wrapper
    return decorator

# -------------------------------------------------------------------
# PROMETHEUS ENDPOINT
# -------------------------------------------------------------------
def metrics_endpoint():
    """Expose metrics for Prometheus scraping"""
    return Response(generate_latest(), mimetype='text/plain')

# -------------------------------------------------------------------
# HEALTH CHECK
# -------------------------------------------------------------------
class HealthChecker:
    """Application health monitoring"""
    
    def __init__(self):
        self.checks = []
    
    def register_check(self, name: str, check_func):
        """Register a health check"""
        self.checks.append((name, check_func))
    
    def check_all(self) -> dict:
        """Run all health checks"""
        results = {}
        overall_healthy = True
        
        for name, check_func in self.checks:
            try:
                healthy = check_func()
                results[name] = {
                    'status': 'healthy' if healthy else 'unhealthy',
                    'timestamp': time.time()
                }
                if not healthy:
                    overall_healthy = False
            except Exception as e:
                results[name] = {
                    'status': 'error',
                    'error': str(e),
                    'timestamp': time.time()
                }
                overall_healthy = False
        
        return {
            'overall': 'healthy' if overall_healthy else 'unhealthy',
            'checks': results
        }

# Global instances
health_checker = HealthChecker()
registry = CollectorRegistry()

# Register default checks
def check_database():
    import sqlite3
    try:
        conn = sqlite3.connect('/tmp/security_audit.db')
        cursor = conn.cursor()
        cursor.execute("SELECT 1")
        conn.close()
        return True
    except:
        return False

def check_redis():
    import redis
    try:
        r = redis.Redis(host='localhost', port=6379)
        r.ping()
        return True
    except:
        return False

health_checker.register_check('database', check_database)
health_checker.register_check('cache', check_redis)
