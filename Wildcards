```python
#!/usr/bin/env python3
"""
Handover Success Monitoring Dashboard
Real-time tracking of handover milestone completion and system stability
"""

import json
from datetime import datetime, timedelta
from pathlib import Path
import sqlite3

class HandoverMonitor:
    """Track and visualize handover progress in real-time"""
    
    def __init__(self, db_path="/tmp/handover_monitor.db"):
        self.db_path = db_path
        self._init_database()
    
    def _init_database(self):
        """Create SQLite database for tracking"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS handover_metrics (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                metric_name TEXT,
                metric_value REAL,
                timestamp TEXT,
                recorded_by TEXT
            )
        ''')
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS incident_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                incident_type TEXT,
                severity TEXT,
                description TEXT,
                resolved BOOLEAN,
                created_at TEXT,
                resolved_at TEXT
            )
        ''')
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS access_changes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id TEXT,
                access_type TEXT,
                action TEXT,
                timestamp TEXT
            )
        ''')
        
        conn.commit()
        conn.close()
    
    def record_metric(self, metric_name: str, value: float, recorded_by: str = "system"):
        """Record a handover metric"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            INSERT INTO handover_metrics (metric_name, metric_value, timestamp, recorded_by)
            VALUES (?, ?, ?, ?)
        ''', (metric_name, value, datetime.utcnow().isoformat(), recorded_by))
        
        conn.commit()
        conn.close()
    
    def record_incident(self, incident_type: str, severity: str, description: str):
        """Record a handover-related incident"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            INSERT INTO incident_log (incident_type, severity, description, resolved, created_at)
            VALUES (?, ?, ?, FALSE, ?)
        ''', (incident_type, severity, description, datetime.utcnow().isoformat()))
        
        conn.commit()
        conn.close()
    
    def get_health_score(self) -> dict:
        """Calculate overall handover health score (0-100)"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        # Calculate component scores
        cursor.execute('''
            SELECT AVG(metric_value) FROM handover_metrics 
            WHERE metric_name LIKE '%training%'
        ''')
        training_score = cursor.fetchone()[0] or 100
        
        cursor.execute('''
            SELECT COUNT(*) FROM incident_log WHERE resolved = FALSE
        ''')
        open_incidents = cursor.fetchone()[0]
        incident_penalty = min(open_incidents * 10, 30)
        
        cursor.execute('''
            SELECT COUNT(DISTINCT user_id) FROM access_changes
            WHERE timestamp >= datetime('now', '-7 days')
        ''')
        new_access_count = cursor.fetchone()[0]
        access_bonus = min(new_access_count * 5, 20)
        
        conn.close()
        
        total_score = max(0, min(100, training_score + access_bonus - incident_penalty))
        
        return {
            "score": total_score,
            "components": {
                "training_readiness": training_score,
                "incident_free": 100 - incident_penalty,
                "access_transition": access_bonus
            },
            "status": "healthy" if total_score >= 80 else "warning" if total_score >= 60 else "critical",
            "calculated_at": datetime.utcnow().isoformat()
        }
    
    def generate_status_report(self) -> str:
        """Generate daily status report"""
        health = self.get_health_score()
        
        report = f"""
{'='*60}
HANDOVER HEALTH STATUS REPORT
{'='*60}
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
Overall Score: {health['score']}/100 ({health['status'].upper()})

Component Scores:
  • Training Readiness:     {health['components']['training_readiness']:.1f}/100
  • Incident-Free Status:   {health['components']['incident_free']:.1f}/100
  • Access Transition:      {health['components']['access_transition']:.1f}/20

Recent Incidents (Last 7 Days):
"""
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT incident_type, severity, description, created_at, resolved
            FROM incident_log 
            WHERE created_at >= datetime('now', '-7 days')
            ORDER BY created_at DESC
            LIMIT 5
        ''')
        
        incidents = cursor.fetchall()
        if incidents:
            for inc in incidents:
                status = "✅ Resolved" if inc[4] else "🔴 Open"
                report += f"  • [{inc[1]}] {inc[0]}: {inc[2]} [{status}]\n"
        else:
            report += "  No incidents recorded\n"
        
        conn.close()
        
        report += f"\n{'='*60}\n"
        return report

# Pre-populate with expected metrics
def initialize_monitoring():
    monitor = HandoverMonitor()
    
    # Expected training completion rates by role
    metrics = [
        ("training_engineering", 85),
        ("training_analysts", 70),
        ("training_management", 60),
        ("credentials_rotated", 0),
        ("docs_reviewed", 45),
        ("shadowing_weeks", 1),
        ("incidents_last_week", 0)
    ]
    
    for name, value in metrics:
        monitor.record_metric(name, value)
    
    return monitor
