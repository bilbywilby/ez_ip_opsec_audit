# HELPER FUNCTIONS
#-------------------------------------------------------------------------------
cleanup_old_slot() {
    log "INFO" "Cleaning up old deployment artifacts..."
    # Remove old containers, prune unused images
    docker system prune -f
    log_success "Cleanup completed"
}

get_current_error_rate() {
    local slot="$1"
    # Query Prometheus metrics
    local error_count=$(curl -s "http://prometheus:9090/api/v1/query" \
        --data-urlencode "query=sum(rate(api_requests_total{slot=${slot},status_code=~'5..'}[1m]))")
    # Parse and calculate rate (implementation varies)
    echo "0.0"
}

