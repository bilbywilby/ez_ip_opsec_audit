#!/usr/bin/env python3
"""
SLA Compliance Tracking and Automated Reporting
Generates monthly SLA reports with actionable insights
"""

import sqlite3
import json
from datetime import datetime, timedelta
from pathlib import Path
from typing import Dict, List, Any
import smtplib
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText

class SLAMonitor:
    """Monitor and report on SLA compliance"""
    
    def __init__(self, db_path: str = '/tmp/security_audit.db'):
        self.db_path = db_path
        self.reporting_period = timedelta(days=30)
        
    def calculate_availability(self, days: int = 30) -> float:
        """Calculate system availability percentage"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cutoff = (datetime.now() - timedelta(days=days)).isoformat()
        
        cursor.execute("""
            SELECT COUNT(*) as total,
                   SUM(CASE WHEN status = 'healthy' THEN 1 ELSE 0 END) as healthy
            FROM uptime_logs
            WHERE timestamp >= ?
        """, (cutoff,))
        
        result = cursor.fetchone()
        conn.close()
        
        if not result or result[0] == 0:
            return 100.0  # Assume healthy if no data
        
        return (result[1] / result[0]) * 100
    
    def calculate_performance_metrics(self) -> Dict[str, float]:
        """Calculate performance SLA metrics"""
        conn = sqlite3.connect(self.db_path)
        
        metrics = {
            'avg_response_time_ms': 0,
            'p95_response_time_ms': 0,
            'p99_response_time_ms': 0,
            'error_rate_percentage': 0
        }
        
        for metric, query in [
            ('avg_response_time_ms', "SELECT AVG(response_time_ms) FROM api_requests"),
            ('p95_response_time_ms', "SELECT PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY response_time_ms) FROM api_requests"),
            ('p99_response_time_ms', "SELECT PERCENTILE_CONT(0.99) WITHIN GROUP (ORDER BY response_time_ms) FROM api_requests"),
            ('error_rate_percentage', """
                SELECT 
                    (SUM(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END) * 100.0 / COUNT(*))
                FROM api_requests
                WHERE timestamp >= datetime('now', '-30 days')
            """)
        ]:
            try:
                cursor = conn.execute(query)
                result = cursor.fetchone()[0]
                metrics[metric] = result or 0
            except:
                metrics[metric] = 0
        
        conn.close()
        return metrics
    
    def calculate_audit_completion_rate(self) -> float:
        """Percentage of scheduled audits that completed successfully"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute("""
            SELECT 
                (COUNT(*) FILTER (WHERE status = 'completed'))::float * 100 / NULLIF(COUNT(*), 0)
            FROM scheduled_audits
            WHERE scheduled_at >= datetime('now', '-30 days')
        """)
        
        result = cursor.fetchone()[0] or 0
        conn.close()
        
        return result
    
    def generate_sla_report(self, period_start: datetime = None) -> Dict[str, Any]:
        """Generate comprehensive SLA report"""
        if period_start is None:
            period_start = datetime.now() - self.reporting_period
        
        report = {
            'period': {
                'start': period_start.isoformat(),
                'end': datetime.now().isoformat()
            },
            'availability': {
                'percentage': self.calculate_availability(),
                'target': 99.5,
                'status': 'compliant' if self.calculate_availability() >= 99.5 else 'breached'
            },
            'performance': self.calculate_performance_metrics(),
            'audit_completion': {
                'percentage': self.calculate_audit_completion_rate(),
                'target': 95,
                'status': 'compliant' if self.calculate_audit_completion_rate() >= 95 else 'at_risk'
            },
            'incidents': self._count_incidents(period_start),
            'recommendations': self._generate_recommendations()
        }
        
        return report
    
    def _count_incidents(self, since: datetime) -> Dict[str, int]:
        """Count incidents by severity in period"""
        return {
            'critical': 0,  # Would come from incident tracking table
            'high': 0,
            'medium': 0,
            'low': 0
        }
    
    def _generate_recommendations(self) -> List[str]:
        """Generate actionable recommendations based on metrics"""
        recommendations = []
        
        if self.calculate_availability() < 99.5:
            recommendations.append("Increase monitoring coverage to detect downtime faster")
            recommendations.append("Consider implementing additional redundancy")
        
        metrics = self.calculate_performance_metrics()
        if metrics['p95_response_time_ms'] > 2000:
            recommendations.append("Optimize slow endpoints - P95 response time exceeding 2s")
        
        if metrics['error_rate_percentage'] > 1:
            recommendations.append("Investigate elevated error rate - consider increased alerting")
        
        if self.calculate_audit_completion_rate() < 95:
            recommendations.append("Review audit scheduling to improve completion rate")
        
        return recommendations
    
    def export_report(self, report: Dict[str, Any], format: str = 'json') -> str:
        """Export report in various formats"""
        if format == 'json':
            return json.dumps(report, indent=2)
        elif format == 'html':
            return self._render_html_report(report)
        elif format == 'csv':
            return self._render_csv_summary(report)
    
    def _render_html_report(self, report: Dict[str, Any]) -> str:
        """Render HTML version of SLA report"""
        html = f"""
        <!DOCTYPE html>
        <html>
        <head><title>SLA Report - {report['period']['start'][:10]}</title></head>
        <body>
            <h1>Security Audit Platform - SLA Report</h1>
            <h2>Period: {report['period']['start'][:10]} to {report['period']['end'][:10]}</h2>
            
            <h3>Availability</h3>
            <p>Status: {report['availability']['status'].upper()}</p>
            <p>Current: {report['availability']['percentage']:.2f}% | Target: {report['availability']['target']}%</p>
            
            <h3>Recommendations</h3>
            <ul>
                {''.join([f"<li>{rec}</li>" for rec in report['recommendations']])}
            </ul>
        </body>
        </html>
        """
        return html
    
    def send_sla_email(self, recipients: List[str], report: Dict[str, Any]):
        """Email SLA report to stakeholders"""
        msg = MIMEMultipart()
        msg['Subject'] = f'SLA Report - {report["period"]["start"][:10]}'
        msg['From'] = 'sla-reports@example.com'
        msg['To'] = ', '.join(recipients)
        
        body = f"""
        Monthly SLA Report
        
        Period: {report['period']['start'][:10]} to {report['period']['end'][:10]}
        
        Availability: {report['availability']['percentage']:.2f}%
        Status: {report['availability']['status'].upper()}
        
        Incidents: {sum(report['incidents'].values())}
        
        Recommendations:
        {'\n'.join(['- ' + rec for rec in report['recommendations']])}
        
        Full report attached.
        """
        
        msg.attach(MIMEText(body, 'plain'))
        
        # Attach full report
        attachment = MIMEText(json.dumps(report, indent=2), 'json')
        attachment.add_header('Content-Disposition', 'attachment', filename=f'sla_{report["period"]["start"][:10]}.json')
        msg.attach(attachment)
        
        with smtplib.SMTP('smtp.example.com', 587) as server:
            server.starttls()
            server.login('reports@example.com', 'password')
            server.send_message(msg)


def main():
    """CLI interface for SLA reporting"""
    import argparse
    
    parser = argparse.ArgumentParser(description='SLA Compliance Reporter')
    parser.add_argument('--format', choices=['json', 'html', 'csv'], default='json')
    parser.add_argument('--send-email', action='store_true')
    parser.add_argument('--recipients', nargs='+', default=[])
    parser.add_argument('--period-days', type=int, default=30)
    
    args = parser.parse_args()
    
