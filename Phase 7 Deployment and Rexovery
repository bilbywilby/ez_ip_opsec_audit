#!/bin/bash
# scripts/backup_restore.sh - Automated Backup and Restoration
set -euo pipefail

#-------------------------------------------------------------------------------
# CONFIGURATION
#-------------------------------------------------------------------------------
readonly BACKUP_DIR="/mnt/backups/security-audit"
readonly DB_NAME="security_audit"
readonly RETENTION_DAYS="${RETENTION_DAYS:-30}"
readonly COMPRESSION="gzip"

# Encryption key path (store securely!)
readonly ENCRYPTION_KEY_PATH="/etc/security-audit/backup.key"

#-------------------------------------------------------------------------------
# UTILITY FUNCTIONS
#-------------------------------------------------------------------------------
timestamp() {
    date -u '+%Y%m%d_%H%M%S'
}

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a /var/log/security-audit/backup.log
}

create_backup_directory() {
    mkdir -p "${BACKUP_DIR}/{database,logs,config,findings}"
    chmod 700 "${BACKUP_DIR}"
}

encrypt_file() {
    local file="$1"
    if [[ -f "${ENCRYPTION_KEY_PATH}" ]]; then
        openssl enc -aes-256-cbc -salt -pbkdf2 -in "${file}" \
            -out "${file}.enc" -pass file:"${ENCRYPTION_KEY_PATH}"
        rm "${file}"
        echo "${file}.enc"
    else
        log "WARNING" "Encryption key not found - backing up unencrypted"
        echo "${file}"
    fi
}

#-------------------------------------------------------------------------------
# DATABASE BACKUP
#-------------------------------------------------------------------------------
backup_database() {
    log "INFO" "Starting database backup..."
    
    local backup_file="${BACKUP_DIR}/database/db_backup_$(timestamp).sql"
    local temp_dump=$(mktemp)
    
    # PostgreSQL dump
    PGPASSWORD="${DB_PASSWORD}" pg_dump \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname="${DB_NAME}" \
        --format=custom \
        --verbose \
        --file="${temp_dump}"
    
    # Compress and encrypt
    gzip "${temp_dump}"
    
    if [[ "${COMPRESSION}" == "encrypted" ]]; then
        mv "${temp_dump}.gz" "${backup_file}"
    else
        encrypt_file "${backup_file}.gz" || mv "${backup_file}.gz" "${backup_file}"
    fi
    
    log "SUCCESS" "Database backup created: ${backup_file}"
    
    # Verify backup integrity
    if verify_backup "${backup_file}"; then
        log "SUCCESS" "Backup verification passed"
    else
        log "ERROR" "Backup verification failed!"
        return 1
    fi
}

verify_backup() {
    local backup_file="$1"
    
    if [[ -f "${ENCRYPTION_KEY_PATH}" ]] && [[ "${backup_file}" == *.enc ]]; then
        openssl enc -d -aes-256-cbc -pbkdf2 \
            -in "${backup_file}" \
            -out /dev/null \
            -pass file:"${ENCRYPTION_KEY_PATH}" 2>/dev/null
    else
        gunzip -t "${backup_file}" 2>/dev/null
    fi
    
    return $?
}

#-------------------------------------------------------------------------------
# FINDINGS EXPORT BACKUP
#-------------------------------------------------------------------------------
backup_findings() {
    log "INFO" "Exporting findings data..."
    
    # Export recent findings as JSON
    python3 <<EOF
import sqlite3
import json
from datetime import datetime, timedelta

conn = sqlite3.connect('/tmp/security_audit.db')
cursor = conn.cursor()

# Get last 90 days of findings
cutoff = (datetime.now() - timedelta(days=90)).strftime('%Y-%m-%d')

query = '''
    SELECT f.severity, f.type, f.description, a.timestamp
    FROM findings f
    JOIN audit_cycles a ON f.audit_id = a.id
    WHERE DATE(a.timestamp) >= ?
'''

cursor.execute(query, (cutoff,))
rows = cursor.fetchall()

findings_export = []
for row in rows:
    findings_export.append({
        'severity': row[0],
        'type': row[1],
        'description': row[2],
        'timestamp': row[3]
    })

with open('${BACKUP_DIR}/findings/findings_export_{}.json'.format(timestamp()), 'w') as f:
    json.dump(findings_export, f, indent=2)

conn.close()
print(f"Exported {len(findings_export)} findings")
EOF

    log "SUCCESS" "Findings backup completed"
}

#-------------------------------------------------------------------------------
# LOG ARCHIVAL
#-------------------------------------------------------------------------------
archive_old_logs() {
    log "INFO" "Archiving logs older than 30 days..."
    
    find /var/log/security-audit \
        -name "*.log" \
        -mtime +30 \
        -exec gzip {} \;
    
    # Move archived logs to backup
    mv /var/log/security-audit/*.log.gz "${BACKUP_DIR}/logs/" 2>/dev/null || true
    
    log "SUCCESS" "Log archival completed"
}

#-------------------------------------------------------------------------------
# CLEANUP OLD BACKUPS
#-------------------------------------------------------------------------------
cleanup_old_backups() {
    log "INFO" "Removing backups older than ${RETENTION_DAYS} days..."
    
    find "${BACKUP_DIR}" \
        -type f \
        -mtime +"${RETENTION_DAYS}" \
        -delete
    
    # Report deleted count
    local deleted_count=$(find "${BACKUP_DIR}" -type f -mtime +"${RETENTION_DAYS}" | wc -l)
    log "INFO" "Cleaned up ${deleted_count} old backup files"
}

#-------------------------------------------------------------------------------
# DATABASE RESTORE
#-------------------------------------------------------------------------------
restore_database() {
    local backup_file="$1"
    
    if [[ ! -f "${backup_file}" ]]; then
        log "ERROR" "Backup file not found: ${backup_file}"
        return 1
    fi
    
    log "WARNING" "Restoring database from ${backup_file}..."
    log "WARNING" "This will overwrite all existing data!"
    
    read -p "Confirm restoration (yes/no): " confirm
    if [[ "${confirm}" != "yes" ]]; then
        log "INFO" "Restoration cancelled"
        return 0
    fi
    
    # Pre-backup before restore
    log "INFO" "Creating emergency backup before restore..."
    backup_database || true
    
    # Decrypt if needed
    local decompressed="${backup_file}"
    if [[ "${backup_file}" == *.enc ]]; then
        openssl enc -d -aes-256-cbc -pbkdf2 \
            -in "${backup_file}" \
            -out /tmp/restore_temp.sql \
            -pass file:"${ENCRYPTION_KEY_PATH}"
        decompressed="/tmp/restore_temp.sql"
    fi
    
    if [[ "${decompressed}" == *.gz ]]; then
        gunzip -k "${decompressed}"
        decompressed="${decompressed%.gz}"
    fi
    
    # Perform restore
    PGPASSWORD="${DB_PASSWORD}" psql \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname="${DB_NAME}" \
        --file="${decompressed}"
    
    log "SUCCESS" "Database restored from ${backup_file}"
    
    # Cleanup temp files
    rm -f /tmp/restore_temp.sql* 2>/dev/null || true
}

#-------------------------------------------------------------------------------
# FULL SYSTEM BACKUP
#-------------------------------------------------------------------------------
full_system_backup() {
    log "INFO" "=== STARTING FULL SYSTEM BACKUP ==="
    
    create_backup_directory
    
    # Sequential execution with error handling
    backup_database || log "ERROR" "Database backup failed"
    backup_findings || log "ERROR" "Findings backup failed"
    archive_old_logs || log "ERROR" "Log archival failed"
    
    # Calculate backup size
    local backup_size=$(du -sh "${BACKUP_DIR}" | cut -f1)
    log "INFO" "Total backup size: ${backup_size}"
    
    # Upload to remote storage (if configured)
    if [[ -n "${REMOTE_BACKUP_URL:-}" ]]; then
        upload_to_remote_storage
    fi
    
    cleanup_old_backups
    
    log "SUCCESS" "Full system backup completed"
    log "INFO" "=== BACKUP COMPLETE ==="
}

upload_to_remote_storage() {
    log "INFO" "Uploading to remote storage: ${REMOTE_BACKUP_URL}"
    
    case "${REMOTE_STORAGE_TYPE}" in
        s3)
            aws s3 sync "${BACKUP_DIR}" "${REMOTE_BACKUP_URL}" \
                --storage-class STANDARD_IA
            ;;
        gcs)
            gsutil -m rsync -r "${BACKUP_DIR}" "${REMOTE_BACKUP_URL}"
            ;;
        scp)
            scp -r "${BACKUP_DIR}/"* "${REMOTE_BACKUP_USER}@${REMOTE_BACKUP_HOST}:${REMOTE_BACKUP_PATH}"
            ;;
        *)
            log "WARNING" "Unknown remote storage type: ${REMOTE_STORAGE_TYPE}"
            ;;
    esac
    
    log "SUCCESS" "Remote upload completed"
}

#-------------------------------------------------------------------------------
# VERIFICATION TEST
#-------------------------------------------------------------------------------
test_restore_procedure() {
    log "INFO" "Testing restore procedure on isolated instance..."
    
    # Create test environment
    local test_db_name="security_audit_test_$(timestamp)"
    
    # Restore to test database
    local latest_backup=$(ls -t "${BACKUP_DIR}/database/"*.gz | head -1)
    
    if [[ -z "${latest_backup}" ]]; then
        log "ERROR" "No backups found for testing"
        return 1
    fi
    
    # Restore with modified credentials for test
    PGPASSWORD="${DB_PASSWORD}" psql \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname=postgres \
        -c "CREATE DATABASE ${test_db_name};"
    
    restore_database "${latest_backup}"
    
    # Verify data counts
    local original_count=$(PGPASSWORD="${DB_PASSWORD}" psql \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname="${DB_NAME}" \
        -t -c "SELECT COUNT(*) FROM findings;")
    
    local restored_count=$(PGPASSWORD="${DB_PASSWORD}" psql \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname="${test_db_name}" \
        -t -c "SELECT COUNT(*) FROM findings;")
    
    # Compare
    if [[ "${original_count}" == "${restored_count}" ]]; then
        log "SUCCESS" "Restore test passed - data integrity verified"
    else
        log "ERROR" "Restore test failed - counts mismatch (${original_count} vs ${restored_count})"
    fi
    
    # Cleanup test database
    PGPASSWORD="${DB_PASSWORD}" psql \
        --host="${DB_HOST}" \
        --username="${DB_USER}" \
        --dbname=postgres \
        -c "DROP DATABASE ${test_db_name};"
}

#-------------------------------------------------------------------------------
# MAIN
#-------------------------------------------------------------------------------
main() {
    local command="${1:-backup}"
    
    case "${command}" in
        backup|full)
            full_system_backup
            ;;
        restore)
            if [[ -z "${2:-}" ]]; then
                echo "Usage: $0 restore <backup_file>"
                exit 1
            fi
            restore_database "$2"
            ;;
        verify)
            if [[ -z "${2:-}" ]]; then
                echo "Usage: $0 verify <backup_file>"
                exit 1
            fi
            verify_backup "$2"
            ;;
        test)
            test_restore_procedure
            ;;
        cleanup)
            cleanup_old_backups
            ;;
        *)
            cat <<EOF
Usage: $0 {backup|restore|verify|test|cleanup} [options]

Commands:
  backup              Full system backup (default)
  restore <file>      Restore from specified backup file
  verify <file>       Verify backup integrity
  test                Test restore procedure
  cleanup             Remove old backups beyond retention period

Environment Variables:
  BACKUP_DIR          Directory for storing backups
  DB_HOST             Database host
  DB_NAME             Database name
  DB_USER             Database username
  DB_PASSWORD         Database password
  RETENTION_DAYS      Days to retain backups
  REMOTE_BACKUP_URL   Remote storage URL (optional)
EOF
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
