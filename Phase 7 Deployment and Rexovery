    local start_time=$SECONDS
    
    while (( SECONDS - start_time < 300 )); do
        local error_rate=$(get_current_error_rate "${target}")
        
        if (( $(echo "${error_rate} < 1" | bc -l) )); then
            return 0
        fi
        
        log_warning "Error rate ${error_rate}% during switch - monitoring..."
        sleep 10
    done
    
    log_error "Traffic switch monitoring timed out"
    return 1
}

