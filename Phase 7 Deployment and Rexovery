#!/bin/bash
# scripts/deploy.sh - Production Deployment Automation
set -euo pipefail

#-------------------------------------------------------------------------------
# CONFIGURATION
#-------------------------------------------------------------------------------
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="${SCRIPT_DIR}/.."
readonly DEPLOY_ENV="${DEPLOY_ENV:-production}"
readonly DEPLOY_TIMEOUT="${DEPLOY_TIMEOUT:-300}"
readonly HEALTH_CHECK_RETRIES="${HEALTH_CHECK_RETRIES:-5}"
readonly HEALTH_CHECK_INTERVAL="${HEALTH_CHECK_INTERVAL:-10}"

# Environment-specific settings
declare -A ENV_CONFIG
ENV_CONFIG[staging]="staging.example.com deploy-user 80%"
ENV_CONFIG[production]="prod.example.com deploy-user 90%"
ENV_CONFIG[development]="localhost dev-user 100%"

#-------------------------------------------------------------------------------
# LOGGING
#-------------------------------------------------------------------------------
log() {
    local level="$1"
    shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*" | tee -a /var/log/security-audit/deploy.log
}

log_success() { log "✓" "$@"; }
log_warning() { log "⚠" "$@"; }
log_error() { log "✗" "$@" >&2; }

#-------------------------------------------------------------------------------
# PRE-DEPLOYMENT VALIDATIONS
#-------------------------------------------------------------------------------
pre_deploy_checks() {
    log "INFO" "Running pre-deployment validation checks..."
    
    # Check 1: Git repository clean
    if ! git diff-index --quiet HEAD --; then
        log_error "Working directory has uncommitted changes"
        log_warning "Please commit or stash changes before deploying"
        return 1
    fi
    
    # Check 2: Latest branch synced
    log "INFO" "Fetching latest remote state..."
    git fetch origin "${DEPLOY_ENV}"
    local local_sha=$(git rev-parse HEAD)
    local remote_sha=$(git rev-parse "origin/${DEPLOY_ENV}")
    
    if [[ "$local_sha" != "$remote_sha" ]]; then
        log_warning "Local branch diverges from remote (${local_sha} vs ${remote_sha})"
        log "INFO" "Deploying current commit anyway"
    fi
    
    # Check 3: Database migrations ready
    log "INFO" "Checking database migration readiness..."
    if ! python3 -m scripts.migration_check --dry-run; then
        log_error "Database migration checks failed"
        return 1
    fi
    
    # Check 4: Storage capacity
    local usage_percent=$(df /var/log/security-audit | awk 'NR==2 {print $5}' | tr -d '%')
    local max_usage="${ENV_CONFIG[${DEPLOY_ENV}]#* }"
    
    if (( usage_percent > ${max_usage%?} )); then
        log_warning "Storage at ${usage_percent}% - exceeds recommended ${max_usage}"
        log "INFO" "Proceeding but consider cleanup"
    fi
    
    # Check 5: Required secrets present
    if [[ -z "${SECRET_KEY:-}" ]] || [[ -z "${DATABASE_URL:-}" ]]; then
        log_error "Required environment variables not set"
        return 1
    fi
    
    log_success "All pre-deployment checks passed"
    return 0
}

#-------------------------------------------------------------------------------
# DEPLOYMENT PROCESS
#-------------------------------------------------------------------------------
deploy_with_health_check() {
    log "INFO" "Starting deployment procedure..."
    
    # Step 1: Stop old containers gracefully
    log "INFO" "Stopping existing services..."
    docker-compose down --timeout 60
    log_success "Services stopped"
    
    # Step 2: Pull new images
    log "INFO" "Pulling updated Docker images..."
    docker-compose pull
    log_success "Images pulled"
    
    # Step 3: Run database migrations (if any)
    if [[ -n "$(git log --oneline -1 | grep -i migrate)" ]]; then
        log "INFO" "Running database migrations..."
        docker-compose run --rm app python3 manage.py migrate
        log_success "Migrations completed"
    fi
    
    # Step 4: Start services
    log "INFO" "Starting new services..."
    docker-compose up -d
    
    # Wait for services to initialize
    sleep 10
    log_success "Services started"
    
    # Step 5: Health check loop
    log "INFO" "Running health checks (max ${HEALTH_CHECK_RETRIES} retries)..."
    local retries=0
    local success=false
    
    while (( retries < HEALTH_CHECK_RETRIES )); do
        if curl -sf "https://${HOST}/api/health" > /dev/null; then
            log_success "Health check passed on attempt $((retries + 1))"
            success=true
            break
        fi
        
        log_warning "Health check failed, retrying in ${HEALTH_CHECK_INTERVAL}s..."
        sleep "$HEALTH_CHECK_INTERVAL"
        ((retries++))
    done
    
    if [[ "$success" != "true" ]]; then
        log_error "Health checks failed after ${HEALTH_CHECK_RETRIES} attempts"
        rollback
        return 1
    fi
    
    # Step 6: Smoke tests
    log "INFO" "Running smoke tests..."
    if ! python3 -m scripts.smoke_tests; then
        log_warning "Smoke tests had failures - review logs"
    fi
    
    # Step 7: Archive deployment record
    record_deployment
    
    log_success "Deployment completed successfully!"
    
    # Display summary
    echo ""
    echo "=========================================="
    echo "         DEPLOYMENT SUMMARY              "
    echo "=========================================="
    echo "Environment:     ${DEPLOY_ENV^^}"
    echo "Host:            ${HOST}"
    echo "Commit:          $(git rev-parse HEAD)"
    echo "Branch:          $(git branch --show-current)"
    echo "Deployed by:     ${USER}@$(hostname)"
    echo "Timestamp:       $(date -u '+%Y-%m-%d %H:%M:%SZ')"
    echo "=========================================="
    
    return 0
}

#-------------------------------------------------------------------------------
# ROLLBACK PROCEDURE
#-------------------------------------------------------------------------------
rollback() {
    log_error "Initiating rollback procedure..."
    
    # Get previous deployment tag
    local prev_tag=$(docker images | grep "${IMAGE_NAME}" | awk 'NR==2 {print $3}')
    
    if [[ -z "$prev_tag" ]]; then
        log_error "No previous image found - cannot rollback"
        return 1
    fi
    
    log "INFO" "Rolling back to tag: ${prev_tag}"
    
    # Stop current services
    docker-compose down
    
    # Tag and restart with previous image
    docker tag "${prev_tag}" "${IMAGE_NAME}:current"
    docker-compose up -d
    
    # Verify rollback
    sleep 10
    if curl -sf "https://${HOST}/api/health"; then
        log_success "Rollback completed successfully"
    else
        log_error "Rollback verification failed - manual intervention required"
        # Trigger alert
        python3 -m scripts.trigger_alert --severity=critical \
            --title="Rollback Failed" \
            --message="Automatic rollback to ${prev_tag} did not restore service"
    fi
}

