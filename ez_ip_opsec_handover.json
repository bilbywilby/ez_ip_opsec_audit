```bash
#!/bin/bash
# execute_handover.sh - Master script to run all handover tasks

set -euo pipefail

echo "=============================================="
echo "  EZ_IP_OPSEC HANDOVER EXECUTION SUITE"
echo "=============================================="
echo "Started: $(date)"
echo ""

