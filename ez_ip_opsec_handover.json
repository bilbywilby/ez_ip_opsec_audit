## Part 4: Acceptance Checklist with Electronic Signatures

```python
#!/usr/bin/env python3
"""
Handover Acceptance Checklist with Digital Signatures
Generates signed PDF completion certificate
"""

import json
from datetime import datetime
from pathlib import Path
from typing import List, Dict
import hashlib

SIGNATURE_FILE = Path("signatures/signatures.json")
ACCEPTANCE_FILE = Path("acceptance_checklist.json")

class HandoverSigner:
    """Handle electronic signatures for handover acceptance"""
    
    def __init__(self):
        SIGNATURE_FILE.parent.mkdir(exist_ok=True)
        self.signatures = self._load_signatures()
    
    def _load_signatures(self) -> dict:
        """Load existing signature records"""
        if SIGNATURE_FILE.exists():
            with open(SIGNATURE_FILE, "r") as f:
                return json.load(f)
        return {"signatures": [], "verification_key": self._generate_verification_key()}
    
    def _generate_verification_key(self) -> str:
        """Generate unique verification key for this handover"""
        import secrets
        return secrets.token_urlsafe(32)
    
    def capture_signature(self, signer_name: str, signer_role: str,
                         organization_unit: str, ip_address: str = None) -> dict:
        """Capture digital signature with metadata"""
        
        # In production, integrate with DocuSign / Adobe Sign / internal e-sign system
        # For demo, we'll create cryptographic proof of signing
        
        signature_data = {
            "signer_name": signer_name,
            "signer_role": signer_role,
            "organization_unit": organization_unit,
            "timestamp_utc": datetime.utcnow().isoformat(),
            "ip_address": ip_address or "local",
            "handover_verification_key": self.signatures.get("verification_key", ""),
            "signature_hash": hashlib.sha256(
                f"{signer_name}|{signer_role}|{datetime.utcnow().isoformat()}".encode()
            ).hexdigest()[:32]
        }
        
        self.signatures["signatures"].append(signature_data)
        self._save_signatures()
        
        return signature_data
    
    def _save_signatures(self):
        """Save signature records"""
        with open(SIGNATURE_FILE, "w") as f:
            json.dump(self.signatures, f, indent=2)
    
    def verify_signature(self, signature_hash: str) -> bool:
        """Verify signature authenticity"""
        for sig in self.signatures.get("signatures", []):
            if sig.get("signature_hash") == signature_hash:
                return True
        return False
    
    def generate_acceptance_certificate(self) -> str:
        """Generate PDF certificate of completed handover"""
        from reportlab.lib.pagesizes import letter
        from reportlab.pdfgen import canvas
        
        cert_path = Path("generated_certificates/handover_acceptance.pdf")
        
        c = canvas.Canvas(str(cert_path), pagesize=letter)
        width, height = letter
        
        # Header
        c.setFont("Helvetica-Bold", 28)
        c.drawCentredString(width / 2, height - 100, "Handover Acceptance Certificate")
        
        c.setFont("Helvetica", 14)
        c.drawString(50, height - 160, f"Project: ez_ip_opsec")
        c.drawString(50, height - 180, f"Completed on: {datetime.now().strftime('%Y-%m-%d')}")
        
        # Signatories
        y_position = height - 240
        c.setFont("Helvetica-Bold", 14)
        c.drawString(50, y_position, "Authorized Signatories:")
        y_position -= 25
        
        for sig in self.signatures.get("signatures", [])[:6]:
            c.setFont("Helvetica", 12)
            c.drawString(50, y_position, f"• {sig['signer_name']} ({sig['signer_role']})")
            y_position -= 20
        
        # Verification
        c.setFont("Helvetica", 8)
        c.drawString(50, height - 400, f"Verification Key: {self.signatures.get('verification_key', '')[:16]}...")
        
        c.save()
        
        return str(cert_path)


class AcceptanceChecklist:
    """Manage handover acceptance checklist"""
    
    def __init__(self):
        self.checklist = {
            "items": [
                {
                    "id": "CHK001",
                    "item": "All documentation reviewed and acknowledged",
                    "responsible": "Incoming Team Lead",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK002",
                    "item": "Credentials rotated and transferred securely",
                    "responsible": "Security Operations",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK003",
                    "item": "Access permissions validated and granted",
                    "responsible": "Identity Management",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK004",
                    "item": "Disaster recovery drill completed successfully",
                    "responsible": "Platform Engineering",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK005",
                    "item": "On-call shadowing completed (minimum 2 weeks)",
                    "responsible": "Incoming On-Call Engineer",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK006",
                    "item": "All known issues documented and accepted",
                    "responsible": "Technical Lead",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK007",
                    "item": "Budget and cost allocation confirmed",
                    "responsible": "Finance/Procurement",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                },
                {
                    "id": "CHK008",
                    "item": "Contract renewals reviewed and approved",
                    "responsible": "Vendor Management",
                    "verified": False,
                    "verification_date": None,
                    "verified_by": None
                }
            ],
            "deadline": "2024-10-31T17:00:00Z",
            "status": "IN_PROGRESS"
        }
    
    def mark_item_complete(self, item_id: str, verified_by: str):
        """Mark checklist item as complete"""
        for item in self.checklist["items"]:
            if item["id"] == item_id:
                item["verified"] = True
                item["verification_date"] = datetime.utcnow().isoformat()
                item["verified_by"] = verified_by
                self._save_checklist()
                return True
        return False
    
    def progress_summary(self) -> dict:
        """Get checklist progress summary"""
        total = len(self.checklist["items"])
        completed = sum(1 for i in self.checklist["items"] if i["verified"])
        
        return {
            "total": total,
            "completed": completed,
            "pending": total - completed,
            "percent_complete": round(completed / total * 100, 1),
            "deadline": self.checklist["deadline"]
        }
    
    def _save_checklist(self):
        """Save checklist state"""
        with open(ACCEPTANCE_FILE, "w") as f:
            json.dump(self.checklist, f, indent=2)
    
    def generate_progress_bar(self) -> str:
        """Generate ASCII progress bar"""
        summary = self.progress_summary()
        bar_length = 30
        filled = int(bar_length * summary["percent_complete"] / 100)
        
        bar = "█" * filled + "░" * (bar_length - filled)
        
        return f"""
{'=' * 60}
HANDOVER ACCEPTANCE PROGRESS
{'=' * 60}
[{bar}] {summary['percent_complete']}% Complete ({summary['completed']}/{summary['total']} items)

Deadline: {summary['deadline']}

Pending Items:
""" + "\n".join([
    f"  ☐ {item['id']}: {item['item']} (Owner: {item['responsible']})"
    for item in self.checklist["items"] if not item["verified"]
])


# Example usage
def main():
    print("=" * 60)
    print("EZ_IP_OPSEC HANDOVER - ACCEPTANCE CHECKLIST")
    print("=" * 60)
    
    checklist = AcceptanceChecklist()
    signer = HandoverSigner()
    
    # Show progress
    print(checklist.generate_progress_bar())
    
    # Capture signatures (simulate for demo)
    print("\n📝 Capturing Signatures:")
    signatories = [
        ("Jane Doe", "Outgoing Technical Owner", "Engineering"),
        ("John Smith", "Incoming Technical Owner", "Engineering"),
        ("Bob Wilson", "Engineering Manager", "Leadership"),
        ("Alice Johnson", "Information Security Officer", "Security"),
        ("Sarah Miller", "Product Owner", "Product")
    ]
    
    for name, role, dept in signatories:
        sig = signer.capture_signature(name, role, dept)
        print(f"  ✓ Signed: {name} ({role})")
    
    # Generate acceptance certificate
    print("\n🎫 Generating Acceptance Certificate...")
    cert_path = signer.generate_acceptance_certificate()
    print(f"  Certificate: {cert_path}")
    
    # Save final state
    print("\n💾 Saving acceptance records...")
    checklist._save_checklist()
    signer._save_signatures()
    
    print("\n" + "=" * 60)
    print("HANDOVER EXECUTION COMPLETE")
    print("=" * 60)
    print(f"Acceptance File: {ACCEPTANCE_FILE}")
    print(f"Signatures File: {SIGNATURE_FILE}")
    print(f"Certificate: {cert_path}")
    print("=" * 60)


if __name__ == "__main__":
    main()
