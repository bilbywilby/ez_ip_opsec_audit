## Part 3: Training Completion Tracker

```python
#!/usr/bin/env python3
"""
Training Completion Tracker
Tracks who has completed required training and generates certificates
"""

import csv
from pathlib import Path
from datetime import datetime
import hashlib
import json

TRAINING_DATA_FILE = Path("training_records.csv")
CERTIFICATE_TEMPLATE = Path("templates/certificate.html")
OUTPUT_DIR = Path("generated_certificates")

class TrainingTracker:
    """Track and verify training completion"""
    
    def __init__(self):
        OUTPUT_DIR.mkdir(exist_ok=True)
        self.records = []
    
    def load_records(self):
        """Load existing training records"""
        if TRAINING_DATA_FILE.exists():
            with open(TRAINING_DATA_FILE, "r") as f:
                reader = csv.DictReader(f)
                self.records = list(reader)
    
    def add_completion(self, employee_id: str, course_name: str, 
                       completion_date: str, trainer: str,
                       score: float = None):
        """Record training completion"""
        record = {
            "employee_id": employee_id,
            "course_name": course_name,
            "completion_date": completion_date,
            "trainer": trainer,
            "score": score,
            "certificate_hash": self._generate_certificate_hash(employee_id, course_name, completion_date)
        }
        
        self.records.append(record)
        self._save_record(record)
    
    def _generate_certificate_hash(self, *args) -> str:
        """Generate unique hash for certificate verification"""
        data = "|".join(str(a) for a in args)
        return hashlib.sha256(data.encode()).hexdigest()[:16]
    
    def _save_record(self, record: dict):
        """Append record to CSV"""
        file_exists = TRAINING_DATA_FILE.exists()
        
        with open(TRAINING_DATA_FILE, "a", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=record.keys())
            if not file_exists:
                writer.writeheader()
            writer.writerow(record)
    
    def generate_certificate(self, employee_id: str, course_name: str,
                            completion_date: str, employee_name: str):
        """Generate PDF certificate for training completion"""
        import reportlab
        from reportlab.lib.pagesizes import letter
        from reportlab.pdfgen import canvas
        
        cert_path = OUTPUT_DIR / f"cert_{employee_id}_{course_name.replace(' ', '_')}.pdf"
        
        c = canvas.Canvas(str(cert_path), pagesize=letter)
        width, height = letter
        
        # Certificate styling
        c.setFont("Helvetica-Bold", 36)
        c.drawString(200, height - 150, "Certificate of Completion")
        
        c.setFont("Helvetica", 18)
        c.drawString(150, height - 250, f"This certifies that")
        c.setFont("Helvetica-Bold", 24)
        c.drawString(200, height - 290, employee_name)
        c.setFont("Helvetica", 18)
        c.drawString(150, height - 340, f"has successfully completed")
        c.setFont("Helvetica-Bold", 20)
        c.drawString(150, height - 380, course_name)
        c.setFont("Helvetica", 14)
        c.drawString(200, height - 440, f"Completed on: {completion_date}")
        
        # Signature line
        c.line(100, height - 550, 300, height - 550)
        c.drawString(100, height - 570, "Platform Engineering Team")
        
        # Verification QR code placeholder
        c.setFont("Helvetica", 10)
        c.drawString(width - 200, height - 570, 
                    f"Verify: {self._generate_certificate_hash(employee_id, course_name, completion_date)}")
        
        c.save()
        return cert_path
    
    def check_completion_status(self, employee_ids: list, required_courses: list) -> dict:
        """Check which employees have completed required courses"""
        status = {}
        
        for emp_id in employee_ids:
            emp_completions = [r for r in self.records if r['employee_id'] == emp_id]
            missing = [c for c in required_courses 
                      if not any(r['course_name'] == c for r in emp_completions)]
            
            status[emp_id] = {
                "completed": len(emp_completions),
                "missing": missing,
                "complete": len(missing) == 0
            }
        
        return status
    
    def generate_progress_report(self) -> str:
        """Generate HTML progress report"""
        html = """
        <html>
        <head><title>Training Completion Report</title></head>
        <body style="font-family: Arial; padding: 20px;">
        <h1>Training Completion Report</h1>
        <p>Generated: """ + datetime.now().strftime("%Y-%m-%d %H:%M") + """</p>
        <table border="1" style="border-collapse: collapse; width: 100%;">
        <tr style="background: #f0f0f0;">
            <th>Employee ID</th><th>Course</th><th>Completion Date</th><th>Trainer</th>
        </tr>
        """
        
        for record in self.records:
            html += f"""
            <tr>
                <td>{record['employee_id']}</td>
                <td>{record['course_name']}</td>
                <td>{record['completion_date']}</td>
                <td>{record['trainer']}</td>
            </tr>
            """
        
        html += "</table></body></html>"
        
        report_path = OUTPUT_DIR / "training_progress_report.html"
        with open(report_path, "w") as f:
            f.write(html)
        
        return str(report_path)


# Pre-populated training records for handover
PREPOPULATED_RECORDS = [
    {"employee_id": "EMP001", "course_name": "Dashboard Basics", "completion_date": "2024-09-15", "trainer": "@senior-analyst", "score": 95},
    {"employee_id": "EMP002", "course_name": "Incident Response", "completion_date": "2024-09-20", "trainer": "@platform-leads", "score": 88},
    {"employee_id": "EMP003", "course_name": "Database Maintenance", "completion_date": "2024-09-22", "trainer": "@dba-lead", "score": 92},
    {"employee_id": "EMP004", "course_name": "Security Best Practices", "completion_date": "2024-09-25", "trainer": "@security-lead", "score": 90},
]

def initialize_training_tracker():
    """Initialize tracker with pre-existing records"""
    tracker = TrainingTracker()
    
    if not TRAINING_DATA_FILE.exists():
        with open(TRAINING_DATA_FILE, "w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=PREPOPULATED_RECORDS[0].keys())
            writer.writeheader()
            writer.writerows(PREPOPULATED_RECORDS)
    
    return tracker


if __name__ == "__main__":
    tracker = initialize_training_tracker()
    report = tracker.generate_progress_report()
    print(f"Training progress report generated: {report}")
