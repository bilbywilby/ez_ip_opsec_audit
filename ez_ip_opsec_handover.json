## Part 2: Credential Rotation Automation Script

```python
#!/usr/bin/env python3
"""
Credential Rotation Automation for ez_ip_opsec
DO NOT run this in production without proper approval!
Run during maintenance window with audit trail enabled.
"""

import os
import sys
import json
import subprocess
from datetime import datetime, timedelta
from pathlib import Path
import argparse

# Import your vault/secrets manager SDK
# from vault_sdk import VaultClient  # Uncomment and configure for your environment

CONFIG_PATH = Path(__file__).parent.parent / "config" / "credential_rotation.json"
AUDIT_LOG_PATH = Path("/var/log/security-audit/credential_rotation.log")

class CredentialRotator:
    """Handles safe credential rotation with audit logging"""
    
    def __init__(self, environment="production"):
        self.environment = environment
        self.vault_path = f"secret/{environment}/"
        self.rotation_log = []
        
    def log_action(self, action: str, details: dict):
        """Create immutable audit log entry"""
        entry = {
            "timestamp": datetime.utcnow().isoformat(),
            "action": action,
            "environment": self.environment,
            "details": details,
            "operator": os.environ.get("USER", "unknown"),
            "hostname": os.uname().nodename
        }
        self.rotation_log.append(entry)
        
        # Append to audit log file
        with open(AUDIT_LOG_PATH, "a") as f:
            f.write(json.dumps(entry) + "\n")
    
    def rotate_vault_secret(self, path: str, secret_type: str = "password") -> dict:
        """Rotate a secret in HashiCorp Vault (adapt for your secrets manager)"""
        self.log_action("rotation_started", {"path": path, "type": secret_type})
        
        try:
            # Example Vault CLI commands - ADAPT TO YOUR SETUP
            if secret_type == "password":
                # Generate new password
                new_password = self._generate_secure_password(32)
                
                # Update Vault (example - use your actual SDK)
                # client.write(f"{self.vault_path}{path}", {"password": new_password})
                
                # In production, use: vault kv put secret/{path} password={new_password}
                
            elif secret_type == "api_key":
                # Generate new API key
                new_key = self._generate_api_key()
                
                # client.write(f"{self.vault_path}{path}", {"api_key": new_key})
            
            elif secret_type == "certificate":
                # Trigger certificate renewal
                subprocess.run(["certbot", "renew", "--force-renewal"], check=True)
            
            self.log_action("rotation_completed", {"path": path, "success": True})
            return {"success": True, "rotated_path": path}
            
        except Exception as e:
            self.log_action("rotation_failed", {"path": path, "error": str(e)})
            return {"success": False, "path": path, "error": str(e)}
    
    def _generate_secure_password(self, length: int = 32) -> str:
        """Generate cryptographically secure password"""
        import secrets
        import string
        
        alphabet = string.ascii_letters + string.digits + "!@#$%^&*"
        password = ''.join(secrets.choice(alphabet) for _ in range(length))
        
        # Ensure complexity requirements
        if not any(c.isupper() for c in password):
            password = password + secrets.choice(string.ascii_uppercase)
        if not any(c.islower() for c in password):
            password = password + secrets.choice(string.ascii_lowercase)
        if not any(c.isdigit() for c in password):
            password = password + secrets.choice(string.digits)
        if not any(c in "!@#$%^&*" for c in password):
            password = password + secrets.choice("!@#$%^&*")
        
        return password
    
    def _generate_api_key(self, length: int = 64) -> str:
        """Generate API key"""
        import secrets
        return "sk_live_" + secrets.token_hex(length // 2)
    
    def restart_dependent_services(self, services: list) -> dict:
        """Restart services that cache credentials"""
        results = {}
        for service in services:
            try:
                # docker-compose restart {service}
                # kubectl rollout restart deployment/{service}
                subprocess.run(["docker-compose", "restart", service], check=True)
                results[service] = "success"
            except subprocess.CalledProcessError as e:
                results[service] = f"failed: {str(e)}"
        
        self.log_action("services_restarted", {"services": results})
        return results
    
    def validate_rotation(self) -> bool:
        """Verify rotation was successful by testing service health"""
        health_checks = {
            "dashboard": "http://localhost:5000/api/health",
            "api": "http://localhost:5000/api/status"
        }
        
        import requests
        all_healthy = True
        
        for service, url in health_checks.items():
            try:
                response = requests.get(url, timeout=10)
                if response.status_code != 200:
                    all_healthy = False
                    self.log_action("health_check_failed", {
                        "service": service,
                        "status_code": response.status_code
                    })
            except Exception as e:
                all_healthy = False
                self.log_action("health_check_error", {
                    "service": service,
                    "error": str(e)
                })
        
        return all_healthy


def main():
    parser = argparse.ArgumentParser(description="Credential Rotation Tool")
    parser.add_argument("--dry-run", action="store_true", help="Don't actually rotate")
    parser.add_argument("--paths", nargs="+", default=None, help="Specific paths to rotate")
    parser.add_argument("--environment", default="production")
    
    args = parser.parse_args()
    
    rotator = CredentialRotator(args.environment)
    
    # Default paths from HANDOVER.json
    paths_to_rotate = args.paths or [
        "platform/admin",
        "platform/service/dashboard",
        "platform/service/auditor",
        "third-party/slack",
        "cloud/aws"
    ]
    
    print("=" * 60)
    print("CREDENTIAL ROTATION EXECUTION PLAN")
    print("=" * 60)
    print(f"Environment: {args.environment}")
    print(f"Dry Run: {args.dry_run}")
    print(f"Paths to rotate: {len(paths_to_rotate)}")
    print("-" * 60)
    
    # Confirmation prompt
    if not args.dry_run:
        confirmation = input("\n⚠️  WARNING: This will rotate production credentials!\n")
        print("Type 'ROTATE NOW' to continue:")
        confirm = input("> ")
        if confirm != "ROTATE NOW":
            print("Aborted.")
            sys.exit(1)
    
    # Execute rotation
    results = []
    for path in paths_to_rotate:
        print(f"\nRotating: {path}")
        result = rotator.rotate_vault_secret(path)
        results.append(result)
        print(f"Result: {'✓ Success' if result.get('success') else '✗ Failed'}")
    
    # Restart services if rotation successful
    if all(r.get('success') for r in results):
        print("\n🔄 Restarting dependent services...")
        service_results = rotator.restart_dependent_services([
            "dashboard", "scheduler", "audit-runner"
        ])
    
    # Validate
    print("\n🔍 Validating rotation...")
    validation = rotator.validate_rotation()
    
    # Summary
    print("\n" + "=" * 60)
    print("ROTATION SUMMARY")
    print("=" * 60)
    successful = sum(1 for r in results if r.get('success'))
    print(f"Successfully rotated: {successful}/{len(results)}")
    print(f"All services healthy: {validation}")
    print(f"Audit log: {AUDIT_LOG_PATH}")
    print("=" * 60)
    
    return 0 if validation else 1


if __name__ == "__main__":
    sys.exit(main())
```

