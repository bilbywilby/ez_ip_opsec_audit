.PHONY: all setup install deps clean test audit install-systemd uninstall-systemd status-logs

all: audit

setup:
	@./scripts/install-phase2.sh

install:
	@pip3 install -e .

deps:
	@pip3 install psutil pyyaml colorama requests python-dateutil

install-systemd: setup
	@sudo ./scripts/install-phase2.sh
	@echo ""
	@systemctl status security-audit.service --no-pager || true

uninstall-systemd:
	@sudo systemctl stop security-audit.timer
	@sudo systemctl stop security-audit.service
	@sudo systemctl disable security-audit.timer
	@sudo systemctl disable security-audit.service
	@sudo systemctl daemon-reload
	@sudo rm -f /etc/systemd/system/security-audit.{service,timer}
	@echo "Uninstalled systemd service"

audit:
	@python3 src/main.py --output logs/audit-$(shell date +%Y%m%d).txt

audit-quick:
	@python3 src/main.py --quick --output logs/audit-quick-$(shell date +%Y%m%d).txt

status-logs:
	@echo "=== Latest Audit Report ==="
	@ls -lt logs/*.txt 2>/dev/null | head -1 | awk '{print $$9}' | xargs tail -30 || echo "No logs found"

daemon-log:
	@journalctl -u security-audit.service -f

test:
	@python3 -m pytest tests/ -v --tb=short

clean:
	@find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	@find . -type f -name "*.pyc" -delete 2>/dev/null || true
	@find logs -name "*.txt" -mtime +90 -delete 2>/dev/null || true
	@echo "Cleaned cache and old logs"

help:
	@echo "Security Audit Framework - Available Targets:"
	@grep '^[a-zA-Z]' Makefile | cut -d: -f1 | sort
```

### File 5: Verification Workflow Script
```bash
#!/bin/bash
# verify-phase2.sh - Complete validation of Phase 2 deployment
set -euo pipefail

echo "=========================================="
echo "PHASE 2 VERIFICATION WORKFLOW"
echo "=========================================="
echo ""

PASS=0
FAIL=0

check_pass() { echo "✓ PASS: $1"; ((PASS++)); }
check_fail() { echo "✗ FAIL: $1"; ((FAIL++)); }

# 1. Check service user exists
echo "[1] Checking service user..."
if id audit-monitor &>/dev/null; then
    check_pass "Service user exists"
else
    check_fail "Service user missing"
fi

# 2. Check directories
echo "[2] Checking directory structure..."
[[ -d /var/log/security-audit ]] && check_pass "Log directory exists" || check_fail "Log directory missing"
[[ -d /etc/security-audit ]] && check_pass "Config directory exists" || check_fail "Config directory missing"
[[ -x /usr/local/bin/security-audit-runner.sh ]] && check_pass "Runner script executable" || check_fail "Runner not executable"

# 3. Check systemd units
echo "[3] Checking systemd units..."
systemctl cat security-audit.service &>/dev/null && check_pass "Service unit registered" || check_fail "Service unit missing"
systemctl cat security-audit.timer &>/dev/null && check_pass "Timer unit registered" || check_fail "Timer unit missing"

# 4. Check service state
echo "[4] Checking service state..."
systemctl is-active security-audit.timer &>/dev/null && check_pass "Timer active" || check_fail "Timer inactive"
systemctl is-enabled security-audit.timer &>/dev/null && check_pass "Timer enabled" || check_fail "Timer not enabled"

# 5. Check logs
echo "[5] Checking log files..."
AUDIT_FILE=$(ls -t /var/log/security-audit/audit-*.txt 2>/dev/null | head -1)
if [[ -n "$AUDIT_FILE" && -f "$AUDIT_FILE" ]]; then
    check_pass "Audit log exists: $AUDIT_FILE"
else
    check_fail "No audit logs found"
fi

# 6. Check security posture
echo "[6] Checking security configuration..."
systemd-analyze security security-audit.service &>/dev/null && check_pass "Systemd security analysis works" || check_fail "Cannot analyze service"

# 7. Test manual run
echo "[7] Testing manual execution..."
if sudo -u audit-monitor /usr/local/bin/security-audit-runner.sh &>/dev/null; then
    check_pass "Manual execution succeeds"
else
    check_fail "Manual execution fails"
fi

# Summary
echo ""
echo "=========================================="
echo "VERIFICATION SUMMARY"
echo "=========================================="
echo "Passed: $PASS"
echo "Failed: $FAIL"

if [[ $FAIL -eq 0 ]]; then
    echo ""
    echo "✓ ALL CHECKS PASSED - Phase 2 Ready"
    exit 0
else
    echo ""
    echo "✗ SOME CHECKS FAILED - Review above"
    exit 1
fi
```

## Deployment Instructions

### Option A: Automated Deployment (Recommended)
```bash
# Clone or navigate to repository
cd ~/security-audit-framework

# Make scripts executable
chmod +x scripts/install-phase2.sh

# Run automated installer (requires sudo)
sudo ./scripts/install-phase2.sh

# Verify installation
./verify-phase2.sh
```

### Option B: Manual Deployment
```bash
# Step 1: Create user
sudo useradd -r -s /bin/false audit-monitor

# Step 2: Create directories
sudo mkdir -p /var/log/security-audit /etc/security-audit
sudo chown -R audit-monitor:audit-monitor /var/log/security-audit

# Step 3: Install runner
sudo cp scripts/install-phase2.sh /usr/local/bin/security-audit-runner.sh
sudo chmod +x /usr/local/bin/security-audit-runner.sh

# Step 4: Install systemd units
sudo cp systemd/security-audit.service /etc/systemd/system/
sudo cp systemd/security-audit.timer /etc/systemd/system/
sudo systemctl daemon-reload

# Step 5: Enable and start
