### File 3: `scripts/install-phase2.sh`
```bash
#!/bin/bash
#===============================================================================
# PHASE 2 INSTALLATION SCRIPT
# Complete systemd service deployment
#===============================================================================
set -euo pipefail

SERVICE_NAME="security-audit"
SERVICE_USER="audit-monitor"
LOG_DIR="/var/log/security-audit"
CONFIG_DIR="/etc/security-audit"
INSTALL_PREFIX="/usr/local"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1" >&2; }

#-------------------------------------------------------------------------------
# 1. Create Service User
#-------------------------------------------------------------------------------
log_info "Creating service user..."
if ! id "${SERVICE_USER}" &>/dev/null; then
    useradd -r -s /bin/false \
        -c "Security Audit Service Account" \
        "${SERVICE_USER}"
    log_success "User created: ${SERVICE_USER}"
else
    log_warn "User already exists: ${SERVICE_USER}"
fi

#-------------------------------------------------------------------------------
# 2. Create Directory Structure
#-------------------------------------------------------------------------------
log_info "Creating directories..."
mkdir -p "${LOG_DIR}" "${CONFIG_DIR}" "${INSTALL_PREFIX}/bin"
mkdir -p "/tmp/${SERVICE_NAME}"
chown -R "${SERVICE_USER}:${SERVICE_USER}" "${LOG_DIR}" "/tmp/${SERVICE_NAME}"
chmod 750 "${LOG_DIR}"
chmod 700 "/tmp/${SERVICE_NAME}"
chmod 755 "${CONFIG_DIR}"

#-------------------------------------------------------------------------------
# 3. Install Runner Script
#-------------------------------------------------------------------------------
log_info "Installing runner script..."
cat > "${INSTALL_PREFIX}/bin/security-audit-runner.sh" << 'RUNNER_SCRIPT'
#!/bin/bash
# Security Audit Runner Script
set -euo pipefail

LOG_DIR="${LOG_DIR:-/var/log/security-audit}"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
AUDIT_LOG="${LOG_DIR}/audit-${TIMESTAMP}.txt"
ERROR_LOG="${LOG_DIR}/errors-${TIMESTAMP}.log"
PID_FILE="/tmp/security-audit/audit.pid"

echo $$ > "${PID_FILE}"

log() {
    echo "[$(date -Is)] [$$] $*" | tee -a "${AUDIT_LOG}"
}

cleanup() {
    log "Cleaning up..."
    rm -f "${PID_FILE}"
    exit 0
}

trap cleanup EXIT INT TERM
trap 'log "Error occurred"; exit 1' ERR

log "=========================================="
log "Security Audit Cycle Started"
log "Session ID: ${TIMESTAMP}"
log "=========================================="

# Run audit
python3 /usr/local/bin/security-audit.py \
    --config /etc/security-audit/settings.yaml \
    --output "${AUDIT_LOG}" \
    --full \
    2>> "${ERROR_LOG}" || {
    log "❌ Audit failed"
    exit 1
}

log "✓ Audit completed successfully"
log "Report: ${AUDIT_LOG}"

# Cleanup old logs (keep 90 days)
find "${LOG_DIR}" -name "*.txt" -mtime +90 -delete 2>/dev/null || true
RUNNER_SCRIPT

chmod +x "${INSTALL_PREFIX}/bin/security-audit-runner.sh"
chown root:root "${INSTALL_PREFIX}/bin/security-audit-runner.sh"
log_success "Runner installed"

#-------------------------------------------------------------------------------
# 4. Install Python Wrapper
#-------------------------------------------------------------------------------
log_info "Installing Python wrapper..."
cat > "${INSTALL_PREFIX}/bin/security-audit.py" << 'PYTHON_WRAPPER'
#!/usr/bin/env python3
"""Security Audit CLI Entry Point"""
import argparse
import sys
from pathlib import Path

def main():
    parser = argparse.ArgumentParser(description='Security Audit Framework')
    parser.add_argument('--config', default='/etc/security-audit/settings.yaml')
    parser.add_argument('--output', '-o', help='Output file')
    parser.add_argument('--full', action='store_true', help='Full audit mode')
    parser.add_argument('--quick', action='store_true', help='Quick audit mode')
    
    args = parser.parse_args()
    
    # Import from package
    try:
        from security_audit_framework.main import main as audit_main
        audit_main(args)
    except ImportError:
        print("Error: Package not installed. Run: pip install -e .", file=sys.stderr)
        sys.exit(2)

if __name__ == '__main__':
    main()
PYTHON_WRAPPER

chmod +x "${INSTALL_PREFIX}/bin/security-audit.py"
log_success "Python wrapper installed"

#-------------------------------------------------------------------------------
# 5. Install Config
#-------------------------------------------------------------------------------
log_info "Setting up configuration..."
if [[ ! -f "${CONFIG_DIR}/settings.yaml" ]]; then
    mkdir -p "$(dirname "${CONFIG_DIR}")"
    cp config/settings.yaml "${CONFIG_DIR}/" 2>/dev/null || cat > "${CONFIG_DIR}/settings.yaml" << 'CONFIG_YAML'
# Security Audit Framework Configuration
framework:
  name: "Security Audit Framework"
  version: "1.0.0"
  timezone: "UTC"
  log_level: "INFO"

paths:
  logs: "/var/log/security-audit/"
  baseline: "/tmp/security-audit/behavior_baseline.json"

auditing:
  enabled: true
  auto_save: true
  retention_days: 90

network_monitoring:
  enabled: true
  check_interval_seconds: 60
  alert_threshold_changes_per_hour: 5
  track_ip_hops: true
  vpn_detection: true

process_monitoring:
  enabled: true
  detect_hidden: true
  suspicious_process_names:
    - cryptominer
    - miner
    - xmrig
    - nc
    - ncat
    - netcat
CONFIG_YAML
    chown "${SERVICE_USER}:${SERVICE_USER}" "${CONFIG_DIR}/settings.yaml"
fi
log_success "Configuration initialized"

#-------------------------------------------------------------------------------
# 6. Install Systemd Units
#-------------------------------------------------------------------------------
log_info "Installing systemd units..."
cp systemd/security-audit.service /etc/systemd/system/
cp systemd/security-audit.timer /etc/systemd/system/
systemctl daemon-reload
log_success "Systemd units registered"

#-------------------------------------------------------------------------------
# 7. Enable and Start Services
#-------------------------------------------------------------------------------
log_info "Enabling services..."
systemctl enable security-audit.timer
systemctl start security-audit.timer
log_success "Timer enabled and started"

#-------------------------------------------------------------------------------
# 8. Validate Security Posture
#-------------------------------------------------------------------------------
log_info "Validating security configuration..."
if command -v systemd-analyze &>/dev/null; then
    SCORE=$(systemd-analyze security security-audit.service 2>/dev/null | \
        grep -oP '(?<=Overall exposure level for).*?(?=)' | tr -d ' ')
    if [[ -n "${SCORE}" ]]; then
        echo "Security exposure score: ${SCORE}/10"
        if (( $(echo "${SCORE} < 5" | bc -l 2>/dev/null || echo "0") )); then
            log_success "Security hardening adequate"
        else
            log_warn "Consider reviewing security exposure"
            systemd-analyze security security-audit.service 2>/dev/null || true
        fi
    fi
fi

#-------------------------------------------------------------------------------
# Summary
#-------------------------------------------------------------------------------
echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  Phase 2 Installation Complete${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo "Service:     ${SERVICE_NAME}.service"
echo "Timer:       ${SERVICE_NAME}.timer (every 30 min)"
echo "Logs:        ${LOG_DIR}/"
echo "Config:      ${CONFIG_DIR}/settings.yaml"
echo "Runner:      ${INSTALL_PREFIX}/bin/security-audit-runner.sh"
echo "CLI:         ${INSTALL_PREFIX}/bin/security-audit.py"
echo ""
echo -e "${BLUE}Management Commands:${NC}"
echo "  Status:        systemctl status ${SERVICE_NAME}.service"
echo "  View Logs:     journalctl -u ${SERVICE_NAME}.service -f"
echo "  Force Run:     systemctl start ${SERVICE_NAME}.service"
echo "  Next Run:      systemctl list-timers ${SERVICE_NAME}.timer"
echo "  Security:      systemd-analyze security ${SERVICE_NAME}.service"
echo ""
echo -e "${YELLOW}To view audit output:${NC}"
echo "  tail -f ${LOG_DIR}/audit-*.txt"
```

