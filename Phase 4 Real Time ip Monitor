#!/usr/bin/env python3
"""PDF Report Generator"""
from reportlab.lib.pagesizes import letter
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib.units import inch
from reportlab.lib import colors
from datetime import datetime
from typing import List, Dict, Any

class PDFReporter:
    """Generate professional PDF reports"""
    
    def __init__(self, output_path: str):
        self.doc = SimpleDocTemplate(output_path, pagesize=letter)
        self.styles = getSampleStyleSheet()
        self.elements = []
    
    def generate(self, findings: List[Dict[str, Any]], metadata: Dict[str, Any]):
        """Generate PDF report"""
        # Title
        self.elements.append(Paragraph("Security Audit Report", self.styles['Title']))
        self.elements.append(Spacer(1, 0.2*inch))
        
        # Metadata
        self.elements.append(Paragraph(f"Generated: {metadata.get('generated_at', datetime.now().isoformat())}", self.styles['Normal']))
        self.elements.append(Paragraph(f"Host: {metadata.get('hostname', 'unknown')}", self.styles['Normal']))
        self.elements.append(Spacer(1, 0.3*inch))
        
        # Summary Table
        summary_data = [
            ['Metric', 'Value'],
            ['Total Findings', str(metadata.get('total_findings', 0))],
            ['Critical', str(metadata.get('critical_count', 0))],
            ['High', str(metadata.get('high_count', 0))],
            ['Medium', str(metadata.get('medium_count', 0))],
            ['Low', str(metadata.get('low_count', 0))]
        ]
        
        summary_table = Table(summary_data)
        summary_table.setStyle(TableStyle([
            ('BACKGROUND', (0, 0), (-1, 0), colors.darkblue),
            ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
            ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
            ('FONTNAME', (0, 0), (-1, 0), 'Helvetica-Bold'),
            ('FONTSIZE', (0, 0), (-1, -1), 10),
            ('BOTTOMPADDING', (0, 0), (-1, 0), 12),
            ('GRID', (0, 0), (-1, -1), 1, colors.black)
        ]))
        
        self.elements.append(summary_table)
        self.elements.append(Spacer(1, 0.3*inch))
        
        # Findings
        self.elements.append(Paragraph("Detailed Findings", self.styles['Heading2']))
        self.elements.append(Spacer(1, 0.2*inch))
        
        severity_map = {
            'CRITICAL': colors.red,
            'HIGH': colors.orange,
            'MEDIUM': colors.yellow,
            'LOW': colors.green
        }
        
        for idx, finding in enumerate(findings, 1):
            severity = finding.get('severity', 'INFO')
            ftype = finding.get('type', 'UNKNOWN')
            desc = finding.get('message', finding.get('description', ''))
            
            color = severity_map.get(severity, colors.gray)
            
            self.elements.append(Paragraph(
                f"<font color='{color.rgbname()}'>{idx}. [{severity}] {ftype}</font>",
                self.styles['Heading3']
            ))
            self.elements.append(Paragraph(f"   {desc}", self.styles['Normal']))
            self.elements.append(Spacer(1, 0.2*inch))
        
        # Build PDF
        self.doc.build(self.elements)
        print(f"PDF report saved: {output_path}")
