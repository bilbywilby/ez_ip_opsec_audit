#!/usr/bin/env python3
"""CSV Export Utility"""
import csv
from pathlib import Path
from datetime import datetime
from typing import List, Dict, Any

class CSVExporter:
    """Export findings to CSV format for SIEM integration"""
    
    def __init__(self, output_path: str):
        self.output_path = Path(output_path)
    
    def export(self, findings: List[Dict[str, Any]], metadata: Dict[str, Any]):
        """Export findings to CSV"""
        self.output_path.parent.mkdir(parents=True, exist_ok=True)
        
        with open(self.output_path, 'w', newline='') as f:
            writer = csv.writer(f)
            
            # Header
            writer.writerow([
                'timestamp', 'audit_timestamp', 'severity', 'type', 
                'description', 'source_ip', 'hostname', 'audit_duration'
            ])
            
            # Data rows
            for finding in findings:
                writer.writerow([
                    datetime.now().isoformat(),
                    metadata.get('timestamp', ''),
                    finding.get('severity', ''),
                    finding.get('type', ''),
                    finding.get('message', finding.get('description', '')),
                    metadata.get('ip_address', ''),
                    metadata.get('hostname', ''),
                    metadata.get('duration_seconds', '')
                ])
        
        print(f"CSV export saved: {self.output_path}")
