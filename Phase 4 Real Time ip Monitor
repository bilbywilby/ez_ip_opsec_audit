### File 7: `src/report_generator.py` (Unified Report Generator)
```python
#!/usr/bin/env python3
"""Unified Report Generator - Orchestrates all report types"""
import os
from pathlib import Path
from datetime import datetime
from typing import List, Dict, Any, Optional

class ReportGenerator:
    """Coordinate all report generation types"""
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.report_dir = Path(config.get('paths', {}).get('logs', './logs')) / 'reports'
        self.report_dir.mkdir(parents=True, exist_ok=True)
    
    def generate_all(self, findings: List[Dict[str, Any]], metadata: Dict[str, Any]):
        """Generate all report formats"""
        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        
        reports = {}
        
        # Text report (always generated)
        from reporters.text_reporter import TextReporter
        reporter = TextReporter()
        # ... add findings ...
        text_path = self.report_dir / f"audit-report-{timestamp}.txt"
        # ... save ...
        reports['text'] = text_path
        
        # JSON report
        if config.get('reporting', {}).get('json', {}).get('enabled', True):
            from reporters.json_reporter import JSONReporter
            json_path = self.report_dir / f"audit-report-{timestamp}.json"
            json_reporter = JSONReporter(json_path)
            json_reporter.generate(findings, metadata)
            reports['json'] = json_path
        
        # CSV report
        if config.get('reporting', {}).get('csv', {}).get('enabled', False):
            from reporters.csv_exporter import CSVExporter
            csv_path = self.report_dir / f"audit-export-{timestamp}.csv"
            csv_exporter = CSVExporter(csv_path)
            csv_exporter.export(findings, metadata)
            reports['csv'] = csv_path
        
        # PDF report
        if config.get('reporting', {}).get('pdf', {}).get('enabled', False):
            from reporters.pdf_reporter import PDFReporter
            pdf_path = self.report_dir / f"audit-report-{timestamp}.pdf"
            pdf_reporter = PDFReporter(pdf_path)
            pdf_reporter.generate(findings, metadata)
            reports['pdf'] = pdf_path
        
        # Summary finding
        print(f"\nReports generated:")
        for fmt, path in reports.items():
            print(f"  ✓ {fmt.upper()}: {path}")
        
        return reports
    
    def archive_old_reports(self, retention_days: int = 90):
        """Delete old reports based on retention policy"""
        cutoff = datetime.now().timestamp() - (retention_days * 86400)
        
        deleted = 0
        for report_file in self.report_dir.iterdir():
            if report_file.stat().st_mtime < cutoff:
                report_file.unlink()
                deleted += 1
        
        print(f"Archived {deleted} old report(s)")
