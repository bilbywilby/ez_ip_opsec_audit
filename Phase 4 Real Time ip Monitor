#!/usr/bin/env python3
"""
Security Audit Dashboard - Flask Web Application
Provides real-time monitoring, historical trends, and interactive reporting
"""

from flask import Flask, render_template, jsonify, request, send_file
from flask_cors import CORS
from pathlib import Path
import json
import os
from datetime import datetime, timedelta
from typing import Dict, List, Any
import sqlite3
import pandas as pd
import plotly.graph_objects as go
import plotly.express as px

app = Flask(__name__)
CORS(app)

# Configuration
LOG_DIR = "/var/log/security-audit"
DB_PATH = "/tmp/security_audit.db"
STATIC_DIR = Path(__file__).parent / "static"

#-------------------------------------------------------------------------------
# Database Setup
#-------------------------------------------------------------------------------
def init_db():
    """Initialize SQLite database for storing audit data"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS audit_cycles (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            duration_seconds REAL,
            total_findings INTEGER,
            critical_count INTEGER,
            high_count INTEGER,
            medium_count INTEGER,
            low_count INTEGER,
            ip_address TEXT,
            vpn_status TEXT
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS findings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            audit_id INTEGER,
            severity TEXT,
            type TEXT,
            description TEXT,
            FOREIGN KEY (audit_id) REFERENCES audit_cycles (id)
        )
    ''')
    
    conn.commit()
    conn.close()

def populate_db_from_logs():
    """Parse existing audit logs and populate database"""
    logs_path = Path(LOG_DIR)
    if not logs_path.exists():
        return
    
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Check if already populated
    cursor.execute("SELECT COUNT(*) FROM audit_cycles")
    if cursor.fetchone()[0] > 0:
        conn.close()
        return
    
    audit_files = sorted(logs_path.glob("audit-*.txt"))
    
    for audit_file in audit_files[-100:]:  # Last 100 audits
        try:
            content = audit_file.read_text()
            
            # Parse metadata
            timestamp = None
            duration = None
            findings_data = []
            
            for line in content.split('\n'):
                if 'Audit Report' in line:
                    timestamp = line.split('-')[1].strip() if '-' in line else None
                elif 'Audit Duration:' in line:
                    try:
                        duration = float(line.split(':')[1].strip().rstrip('s'))
                    except:
                        duration = None
                elif line.startswith('[') and (' - ' in line):
                    # Parse finding
                    parts = line.strip('[]').split(' - ', 1)
                    if len(parts) == 2:
                        severity_type = parts[0].strip()
                        finding_type = parts[1].split(':')[0] if ':' in parts[1] else parts[1]
                        findings_data.append({
                            'severity': severity_type,
                            'type': finding_type,
                            'description': ''
                        })
            
            # Insert audit cycle
            cursor.execute('''
                INSERT INTO audit_cycles 
                (timestamp, duration_seconds, total_findings, critical_count, 
                 high_count, medium_count, low_count, ip_address, vpn_status)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                timestamp or datetime.now().isoformat(),
                duration or 0,
                len(findings_data),
                len([f for f in findings_data if f['severity'] == 'CRITICAL']),
                len([f for f in findings_data if f['severity'] == 'HIGH']),
                len([f for f in findings_data if f['severity'] == 'MEDIUM']),
                len([f for f in findings_data if f['severity'] == 'LOW']),
                '',
                ''
            ))
            
            audit_id = cursor.lastrowid
            
            # Insert findings
            for finding in findings_data[:20]:  # Limit findings
                cursor.execute('''
                    INSERT INTO findings (audit_id, severity, type, description)
                    VALUES (?, ?, ?, ?)
                ''', (audit_id, finding['severity'], finding['type'], finding['description']))
                
        except Exception as e:
            print(f"Error parsing {audit_file}: {e}")
            continue
    
    conn.commit()
    conn.close()

