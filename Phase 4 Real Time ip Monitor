    return render_template('dashboard.html')

@app.route('/api/status')
def api_status():
    """Get current system status"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Get latest audit
    cursor.execute("SELECT * FROM audit_cycles ORDER BY timestamp DESC LIMIT 1")
    latest = cursor.fetchone()
    
    # Get summary stats
    cursor.execute("SELECT COUNT(*), SUM(total_findings), SUM(critical_count) FROM audit_cycles")
    totals = cursor.fetchone()
    
    # Get recent trends (last 7 days)
    seven_days_ago = (datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')
    cursor.execute("""
        SELECT DATE(timestamp), SUM(total_findings), AVG(duration_seconds)
        FROM audit_cycles WHERE timestamp >= ? GROUP BY DATE(timestamp)
    """, (seven_days_ago,))
    
    daily_trends = [{"date": row[0], "findings": row[1], "avg_duration": row[2]} 
                   for row in cursor.fetchall()]
    
    conn.close()
    
    return jsonify({
        "status": "healthy",
        "last_audit": {
            "timestamp": latest[0] if latest else None,
            "findings": latest[3] if latest else 0,
            "critical": latest[4] if latest else 0,
        },
        "summary": {
            "total_audits": totals[0] if totals else 0,
            "total_findings": totals[1] if totals else 0,
            "critical_total": totals[2] if totals else 0,
        },
        "daily_trends": daily_trends
    })

@app.route('/api/findings')
def api_findings():
    """Get recent findings"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    limit = int(request.args.get('limit', 50))
    severity = request.args.get('severity')
    
    query = """
        SELECT f.severity, f.type, f.description, a.timestamp
        FROM findings f
        JOIN audit_cycles a ON f.audit_id = a.id
    """
    
    if severity:
        query += f" WHERE f.severity = '{severity}'"
    
    query += f" ORDER BY a.timestamp DESC LIMIT {limit}"
    
    cursor.execute(query)
    findings = [
        {
            "severity": row[0],
            "type": row[1],
            "description": row[2],
            "timestamp": row[3]
        }
        for row in cursor.fetchall()
    ]
    
    conn.close()
    return jsonify(findings)

@app.route('/api/trends')
def api_trends():
    """Get trend analysis data"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    days = int(request.args.get('days', 30))
    cutoff = (datetime.now() - timedelta(days=days)).strftime('%Y-%m-%d %H:%M:%S')
    
    # Daily findings
    cursor.execute("""
        SELECT DATE(timestamp) as day, 
               SUM(total_findings) as findings,
               SUM(critical_count) as critical,
               SUM(high_count) as high,
               SUM(medium_count) as medium
        FROM audit_cycles 
        WHERE timestamp >= ?
        GROUP BY DATE(timestamp)
        ORDER BY day ASC
    """, (cutoff,))
    
    daily = [{"date": row[0], **{k: row[i+1] for i, k in enumerate(["findings", "critical", "high", "medium"])}} 
             for row in cursor.fetchall()]
    
    # Hourly distribution (current day)
    today = datetime.now().strftime('%Y-%m-%d')
    cursor.execute("""
        SELECT strftime('%H', timestamp) as hour, 
               SUM(total_findings) as count
        FROM audit_cycles 
        WHERE DATE(timestamp) = ?
        GROUP BY HOUR
        ORDER BY hour ASC
    """, (today,))
    
    hourly = [{"hour": row[0], "count": row[1]} for row in cursor.fetchall()]
    
    conn.close()
    
    return jsonify({
        "daily": daily,
        "hourly": hourly
    })

@app.route('/api/findings-by-type')
def api_findings_by_type():
    """Get findings grouped by type"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
        SELECT f.type, COUNT(*), SUM(CASE WHEN f.severity = 'CRITICAL' THEN 1 ELSE 0 END),
               SUM(CASE WHEN f.severity = 'HIGH' THEN 1 ELSE 0 END)
        FROM findings f
        GROUP BY f.type
        ORDER BY COUNT(*) DESC
        LIMIT 20
    """)
    
    types = [
        {
            "type": row[0],
            "count": row[1],
            "critical": row[2],
            "high": row[3]
        }
        for row in cursor.fetchall()
    ]
    
    conn.close()
    return jsonify(types)

@app.route('/reports/latest')
