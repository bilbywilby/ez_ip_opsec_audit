        if not self.enabled or not findings or not self.api_token or not self.user_key:
            return False
        
        try:
            # Determine priority based on severity
            has_critical = any(f.get('severity') == 'CRITICAL' for f in findings)
            has_high = any(f.get('severity') == 'HIGH' for f in findings)
            
            priority = 2 if has_critical else (1 if has_high else self.priority)
            
            # Format message
            title = f"Security Alert - {len(findings)} issues"
            message_lines = [f"Found {len(findings)} security findings"]
            
            for finding in findings[:3]:
