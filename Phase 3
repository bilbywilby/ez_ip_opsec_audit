#!/usr/bin/env python3
"""Base Alerter Class - All alerters inherit from this"""
from abc import ABC, abstractmethod
from datetime import datetime
from typing import Dict, List, Any, Optional

class BaseAlerter(ABC):
    """Abstract base class for all alerters"""
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.enabled = config.get('enabled', False)
        self.quiet_hours_start = config.get('quiet_hours_start', None)
        self.quiet_hours_end = config.get('quiet_hours_end', None)
        self.rate_limit_per_hour = config.get('rate_limit_per_hour', 10)
        self._sent_count = 0
        self._last_sent = None
        
    def should_send_now(self) -> bool:
        """Check if alert should be sent based on quiet hours and rate limits"""
        if not self.enabled:
            return False
            
        # Check quiet hours
        if self._is_quiet_hour():
            return False
            
        # Check rate limit
        if self._exceeds_rate_limit():
            return False
            
        return True
    
    def _is_quiet_hour(self) -> bool:
        """Check if currently in quiet hours"""
        if self.quiet_hours_start is None or self.quiet_hours_end is None:
            return False
            
        current_hour = datetime.now().hour
        
        # Handle overnight quiet hours (e.g., 22:00 to 07:00)
        if self.quiet_hours_start > self.quiet_hours_end:
            return current_hour >= self.quiet_hours_start or current_hour < self.quiet_hours_end
        else:
            return self.quiet_hours_start <= current_hour < self.quiet_hours_end
    
    def _exceeds_rate_limit(self) -> bool:
        """Check if we've exceeded rate limit"""
        if self.rate_limit_per_hour == 0:
            return False
            
        if self._last_sent is None:
            return False
            
        # Count alerts in last hour
        one_hour_ago = datetime.now().timestamp() - 3600
        # Simple counter (production would need database/caching layer)
        return self._sent_count >= self.rate_limit_per_hour
    
    @abstractmethod
    def send_alert(self, findings: List[Dict[str, Any]]) -> bool:
        """Send alert - implemented by subclasses"""
        pass
    
    def _format_message(self, findings: List[Dict[str, Any]], channel: str) -> str:
        """Common message formatter for all channels"""
        if not findings:
            return "No findings"
            
        critical = [f for f in findings if f.get('severity') == 'CRITICAL']
        high = [f for f in findings if f.get('severity') == 'HIGH']
        medium = [f for f in findings if f.get('severity') == 'MEDIUM']
        
        lines = [
            f"🔒 Security Audit Alert",
            f"",
            f"Severity Breakdown:",
            f"  🔴 Critical: {len(critical)}",
            f"  🟠 High: {len(high)}",
            f"  🟡 Medium: {len(medium)}",
            f"",
            f"Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}",
            f"Host: {self.config.get('hostname', 'unknown')}",
            f"",
            f"Top Findings:",
        ]
        
        for idx, finding in enumerate(findings[:5], 1):
            severity = finding.get('severity', 'UNKNOWN')
            ftype = finding.get('type', 'UNKNOWN')
            msg = finding.get('message', finding.get('description', 'No details'))[:150]
            lines.append(f"  {idx}. [{severity}] {ftype}: {msg}")
        
        if len(findings) > 5:
            lines.append(f"  ... and {len(findings) - 5} more")
            
        return "\n".join(lines)
    
    def _record_sent(self):
        """Record that an alert was sent"""
        self._sent_count += 1
        self._last_sent = datetime.now()
