                message_lines.append(f"{severity}: {ftype}")
            
            # Add link to full report
            report_url = self.config.get('report_url', '')
            if report_url:
                message_lines.append(f"\nSee full report: {report_url}")
            
            message = "\n".join(message_lines)
            
            payload = {
                'token': self.api_token,
                'user': self.user_key,
                'title': title,
                'message': message,
                'priority': priority,
                'sound': self.sound,
                'timestamp': int(__import__('datetime').datetime.now().timestamp()),
                'url': report_url if report_url else '',
                'url_title': 'View Full Report' if report_url else ''
            }
            
            # Send to Pushover
