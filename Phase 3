#!/usr/bin/env python3
"""Alert Manager - Central orchestration with deduplication and escalation"""
import hashlib
from datetime import datetime, timedelta
from collections import defaultdict
from typing import Dict, List, Any, Optional, Set
import json
import os

class AlertManager:
    """Central alert manager handling routing, deduplication, and escalation"""
    
    def __init__(self, config: Dict[str, Any]):
        self.config = config
        self.alerters = []
        self.dedup_window = config.get('dedup_window_seconds', 300)  # 5 minutes
        self.escalation_config = config.get('escalation', {})
        self._recent_hashes: Set[str] = set()
        self._history_file = config.get('history_file', '/tmp/alert_history.json')
        self._suppress_until: Optional[datetime] = None
        
        # Initialize alerters
        self._init_alerters(config)
        
        # Load history
        self._load_history()
    
    def _init_alerters(self, config: Dict[str, Any]):
        """Initialize all configured alerters"""
        from .email_alerter import EmailAlerter
        from .slack_alerter import SlackAlerter
        from .discord_alerter import DiscordAlerter
        from .pushover_alerter import PushoverAlerter
        
        alerter_configs = config.get('alerters', {})
        
        if alerter_configs.get('email', {}).get('enabled'):
            self.alerters.append(EmailAlerter(alerter_configs['email']))
        
        if alerter_configs.get('slack', {}).get('enabled'):
            self.alerters.append(SlackAlerter(alerter_configs['slack']))
        
        if alerter_configs.get('discord', {}).get('enabled'):
            self.alerters.append(DiscordAlerter(alerter_configs['discord']))
        
        if alerter_configs.get('pushover', {}).get('enabled'):
            self.alerters.append(PushoverAlerter(alerter_configs['pushover']))
    
    def process_findings(self, findings: List[Dict[str, Any]], 
                         force: bool = False) -> Dict[str, Any]:
        """Main entry point for processing security findings"""
        result = {
            'processed_at': datetime.now().isoformat(),
            'total_findings': len(findings),
            'alerts_sent': 0,
            'alerts_suppressed': 0,
            'deduplicated': [],
            'escalation_triggered': False,
        }
        
        if not findings:
            return result
        
        # Check if we should suppress alerts (post-escalation cooldown)
        if self._should_suppress():
            result['alerts_suppressed'] = len(findings)
            return result
        
        # Route findings by severity
        critical = [f for f in findings if f.get('severity') == 'CRITICAL']
        high = [f for f in findings if f.get('severity') == 'HIGH']
        others = [f for f in findings if f.get('severity') not in ['CRITICAL', 'HIGH']]
        
        # Process based on severity routing
        if critical:
            result['alerts_sent'] += self._send_to_all_alerters(critical)
            self._trigger_escalation('CRITICAL', critical)
        
        if high:
            result['alerts_sent'] += self._send_to_priority_alerters(high)
            self._trigger_escalation('HIGH', high)
        
        if others:
            result['alerts_sent'] += self._send_to_all_alerters(others)
        
        # Deduplication
        result['deduplicated'] = self._remove_duplicates(findings)
        
        # Save history
        self._save_history()
        
        return result
    
    def _send_to_all_alerters(self, findings: List[Dict[str, Any]]) -> int:
        """Send to all enabled alerters"""
        sent = 0
        for alerter in self.alerters:
            try:
                if alerter.should_send_now():
                    if alerter.send_alert(findings):
                        sent += 1
                        alerter._record_sent()
            except Exception as e:
                print(f"Error with alerter {type(alerter).__name__}: {e}")
        return sent
    
    def _send_to_priority_alerters(self, findings: List[Dict[str, Any]]) -> int:
        """Send only to priority alerters (email, push)"""
        # Priority: Email + Push, skip Slack/Discord for noise reduction
        priority_alerter_types = ['EmailAlerter', 'PushoverAlerter']
        sent = 0
        
        for alerter in self.alerters:
            if type(alerter).__name__ in priority_alerter_types:
                try:
                    if alerter.should_send_now():
                        if alerter.send_alert(findings):
                            sent += 1
                            alerter._record_sent()
                except Exception as e:
                    print(f"Error with alerter {type(alerter).__name__}: {e}")
        
        return sent
    
    def _remove_duplicates(self, findings: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """Remove duplicate findings within dedup window"""
        unique = []
        current_time = datetime.now().timestamp()
        
        for finding in findings:
            # Generate hash of finding content
            content = f"{finding.get('type', '')}-{finding.get('message', '')}"
            finding_hash = hashlib.md5(content.encode()).hexdigest()
            
            # Check if recently seen
            is_duplicate = False
            for recent_hash, timestamp in list(self._recent_hashes):
                if recent_hash == finding_hash:
                    if current_time - timestamp < self.dedup_window:
                        is_duplicate = True
                        break
            
            if not is_duplicate:
                unique.append(finding)
                self._recent_hashes.add((finding_hash, current_time))
        
        # Clean old hashes
        self._recent_hashes = [(h, t) for h, t in self._recent_hashes 
                              if current_time - t < self.dedup_window]
        
        return unique
    
    def _trigger_escalation(self, severity: str, findings: List[Dict[str, Any]]):
        """Trigger escalation policy based on severity"""
        esc_config = self.escalation_config.get(severity, {})
        
        if not esc_config.get('enabled', False):
            return
        
        # Check escalation conditions
        threshold = esc_config.get('threshold', 1)
        if len(findings) >= threshold:
            print(f"Escalation triggered for {severity}: {len(findings)} findings")
            
            # Enable all alerters temporarily
            for alerter in self.alerters:
                alerter.rate_limit_per_hour = esc_config.get('override_rate_limit', 100)
            
            # Set suppression timer
            cooldown_minutes = esc_config.get('cooldown_minutes', 30)
            self._suppress_until = datetime.now() + timedelta(minutes=cooldown_minutes)
            
            # Optional: Send escalation notification
            if esc_config.get('notify_manager', False):
                self._send_escalation_notification(severity, findings)
    
    def _send_escalation_notification(self, severity: str, findings: List[Dict[str, Any]]):
        """Send special escalation notification"""
        # Could integrate with PagerDuty, OpsGenie, etc.
        message = f"ESCALATION: {len(findings)} {severity} findings require attention"
        print(message)  # Replace with actual escalation service integration
    
    def _should_suppress(self) -> bool:
        """Check if alerts should be suppressed"""
        if self._suppress_until is None:
            return False
        
        return datetime.now() < self._suppress_until
    
    def _load_history(self):
        """Load alert history from file"""
        if os.path.exists(self._history_file):
            try:
                with open(self._history_file, 'r') as f:
                    history = json.load(f)
                    self._recent_hashes = set(tuple(h) for h in history.get('hashes', []))
            except:
                pass
    
    def _save_history(self):
        """Save alert history to file"""
        history = {
            'hashes': list(self._recent_hashes),
            'last_updated': datetime.now().isoformat()
        }
        try:
            os.makedirs(os.path.dirname(self._history_file), exist_ok=True)
            with open(self._history_file, 'w') as f:
                json.dump(history, f)
        except:
            pass

# Helper method to integrate with main.py
def create_alert_manager(config: Dict[str, Any]) -> AlertManager:
    """Factory function to create properly configured AlertManager"""
    # Inject hostname for email/slack templates
    import socket
    config.setdefault('alerters', {})
    config['alerters'].setdefault('email', {})['hostname'] = socket.gethostname()
    config['alerters'].setdefault('slack', {})['hostname'] = socket.gethostname()
    return AlertManager(config)
