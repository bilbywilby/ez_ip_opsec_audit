        if self._is_locked_out(username):
            return False, "Account locked due to too many failed attempts"
        
        user = self.users[username]
        salt = user['salt']
        test_hash = hashlib.pbkdf2_hmac('sha256', password.encode(), salt.encode(), 100000)
        
        if test_hash.hex() != user['password_hash']:
            self._record_failed_attempt(username)
            return False, "Invalid credentials"
        
        # Clear failed attempts on success
        self.failed_attempts.pop(username, None)
        return True, "Login successful"
    
    def _is_locked_out(self, username: str) -> bool:
        """Check if user is temporarily locked out"""
        if username not in self.failed_attempts:
            return False
        
        last_attempt = self.failed_attempts[username]['last_attempt']
        failures = self.failed_attempts[username]['count']
        
        if failures >= config.security.max_login_attempts:
            lockout_end = last_attempt + timedelta(minutes=config.security.lockout_duration_minutes)
            if datetime.now() < lockout_end:
                return True
        
        return False
    
    def _record_failed_attempt(self, username: str):
        """Record failed login attempt"""
        if username not in self.failed_attempts:
            self.failed_attempts[username] = {'count': 1, 'last_attempt': datetime.now()}
        else:
            self.failed_attempts[username]['count'] += 1
            self.failed_attempts[username]['last_attempt'] = datetime.now()
    
    def generate_token(self, username: str) -> str:
        """Generate JWT token for authenticated user"""
        payload = {
            'sub': username,
            'iat': datetime.now(),
            'exp': datetime.now() + timedelta(hours=config.security.token_expiry_hours)
        }
        return jwt.encode(payload, config.security.jwt_secret_key, algorithm='HS256')
    
    def validate_token(self, token: str) -> dict:
        """Validate JWT token and return decoded payload"""
        try:
            payload = jwt.decode(token, config.security.jwt_secret_key, algorithms=['HS256'])
            return payload
        except jwt.ExpiredSignatureError:
            return {'error': 'Token expired'}
        except jwt.InvalidTokenError:
            return {'error': 'Invalid token'}

# Global auth instance
auth = UserAuth()

def login_required(f):
    """Decorator to protect routes requiring authentication"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        token = None
        
        # Get token from header
        if 'Authorization' in request.headers:
            auth_header = request.headers['Authorization']
            if auth_header.startswith('Bearer '):
                token = auth_header[7:]
        
        if not token:
            return jsonify({'error': 'Missing authentication token'}), 401
        
        payload = auth.validate_token(token)
        
        if 'error' in payload:
            return jsonify({'error': payload['error']}), 401
        
        g.current_user = payload['sub']
        return f(*args, **kwargs)
    
    return decorated_function

def rate_limit(f):
    """Rate limiting decorator"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if not config.security.enable_rate_limiting:
            return f(*args, **kwargs)
        
        client_ip = request.remote_addr
        cache_key = f"rate_limit:{client_ip}:{request.endpoint}"
        
        # Simple in-memory rate limiting (use Redis in production)
        from flask_caching import Cache
        cache = Cache(app.config={'CACHE_TYPE': 'simple'})
        
        request_count = cache.get(cache_key) or 0
        
        if request_count >= config.security.rate_limit_requests:
            return jsonify({'error': 'Rate limit exceeded'}), 429
        
        cache.set(cache_key, request_count + 1, timeout=config.security.rate_limit_window_seconds)
        return f(*args, **kwargs)
    
    return decorated_function
