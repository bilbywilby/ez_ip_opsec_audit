#!/usr/bin/env python3
"""
Scheduled audit execution using APScheduler
"""

from apscheduler.schedulers.background import BackgroundScheduler
from apscheduler.triggers.cron import CronTrigger
from apscheduler.events import EVENT_JOB_ERROR, EVENT_JOB_EXECUTED
import logging
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))
from audit_runner import run_full_security_audit
from alerting.notifier import notifier
from dashboard.app import populate_db_from_logs

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class AuditScheduler:
    """Manage automated audit scheduling"""
    
    def __init__(self):
        self.scheduler = BackgroundScheduler()
        self._setup_event_listeners()
    
    def _setup_event_listeners(self):
        """Register job event handlers"""
        self.scheduler.add_listener(
            self._job_executed,
            EVENT_JOB_EXECUTED
        )
        self.scheduler.add_listener(
            self._job_error,
            EVENT_JOB_ERROR
        )
    
    def _job_executed(self, event):
        """Handle successful job completion"""
        logger.info(f"Job {event.job_id} executed successfully")
        populate_db_from_logs()  # Sync with dashboard
    
    def _job_error(self, event):
        """Handle job errors with alerting"""
        logger.error(f"Job {event.job_id} failed")
        notifier.send_alert(
            "CRITICAL",
            "Audit Scheduler Job Failed",
            f"Job {event.job_id} encountered an error",
            {'exception': str(event.exception)}
        )
    
    def schedule_audit(self, cron_expression: str = "0 * * * *"):
        """Schedule regular audit runs (default: hourly)"""
        self.scheduler.add_job(
            run_full_security_audit,
            CronTrigger.from_crontab(cron_expression),
            id='scheduled_security_audit',
            replace_existing=True,
            max_instances=1
        )
        logger.info(f"Scheduled audit with cron: {cron_expression}")
    
    def start(self):
        """Start the scheduler"""
        self.scheduler.start()
        logger.info("Audit scheduler started")
    
    def stop(self):
        """Stop the scheduler"""
        self.scheduler.shutdown(wait=False)
        logger.info("Audit scheduler stopped")

# Create global scheduler instance
scheduler = AuditScheduler()
