            retention_days=int(os.getenv('LOG_RETENTION_DAYS', 90)),
            max_file_size_mb=int(os.getenv('MAX_LOG_SIZE_MB', 100))
        )
    
    @property
    def alerts(self) -> AlertConfig:
        channels_str = os.getenv('ALERT_CHANNELS', '')
        channels = [c.strip() for c in channels_str.split(',') if c.strip()]
        
        return AlertConfig(
            enabled=os.getenv('ALERTS_ENABLED', 'true').lower() == 'true',
            channels=channels if channels else ['email'],
            severity_threshold=os.getenv('ALERT_SEVERITY_THRESHOLD', 'HIGH'),
            cooldown_minutes=int(os.getenv('ALERT_COOLDOWN_MINUTES', 15))
        )
    
    @property
    def server(self) -> ServerConfig:
        return ServerConfig(
            host=os.getenv('SERVER_HOST', '0.0.0.0'),
            port=int(os.getenv('SERVER_PORT', 5000)),
            debug=os.getenv('FLASK_DEBUG', 'false').lower() == 'true',
            workers=int(os.getenv('GUNICORN_WORKERS', 4)),
            threads=int(os.getenv('GUNICORN_THREADS', 2))
        )
    
    def validate(self) -> List[str]:
        """Validate configuration requirements"""
        errors = []
        
        if not self.alerts.enabled:
            return errors
        
        if 'email' in self.alerts.channels:
            if not all([
                os.getenv('SMTP_SERVER'),
                os.getenv('SMTP_USERNAME'),
                os.getenv('SMTP_PASSWORD'),
                os.getenv('ALERT_FROM_EMAIL')
            ]):
                errors.append("Email alerts enabled but SMTP credentials incomplete")
        
        if 'webhook' in self.alerts.channels:
            if not os.getenv('ALERT_WEBHOOK_URL'):
