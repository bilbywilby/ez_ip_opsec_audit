config = ConfigManager()

class AlertSeverity:
    CRITICAL = "CRITICAL"
    HIGH = "HIGH"
    MEDIUM = "MEDIUM"
    LOW = "LOW"

class Notifier:
    """Unified notification dispatcher"""
    
    def __init__(self):
        self.channels = []
        self._setup_channels()
    
    def _setup_channels(self):
        """Initialize notification channels based on configuration"""
        if config.notifications.slack_webhook_url:
            self.channels.append(SlackNotifier(config.notifications.slack_webhook_url))
        
        if config.notifications.email_smtp_server:
            self.channels.append(EmailNotifier(
                config.notifications.email_smtp_server,
                config.notifications.email_port,
                config.notifications.email_username,
                config.notifications.email_password
            ))
    
    def send_alert(self, severity: str, title: str, message: str, 
                   metadata: Optional[dict] = None):
        """Send alert to all configured channels"""
        results = []
        
        for channel in self.channels:
            try:
                result = channel.send(severity, title, message, metadata)
                results.append({
                    'channel': channel.__class__.__name__,
                    'success': True,
                    'result': result
                })
            except Exception as e:
                results.append({
                    'channel': channel.__class__.__name__,
                    'success': False,
                    'error': str(e)
                })
        
        return results
    
    def check_and_alert_findings(self, audit_data: dict):
        """Analyze audit data and trigger alerts based on thresholds"""
        critical_count = audit_data.get('critical_count', 0)
        
        if critical_count >= config.notifications.critical_alert_threshold:
            self.send_alert(
                AlertSeverity.CRITICAL,
                "Critical Security Findings Detected",
                f"Audit detected {critical_count} critical issue(s) requiring immediate attention",
                audit_data
            )

