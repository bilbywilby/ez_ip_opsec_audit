            return False
    
    def _format_email_body(self, severity: str, finding_type: str, 
                           description: str, metadata: Dict) -> str:
        """Format HTML email body"""
        html = f"""
        <html>
        <body style="font-family: Arial, sans-serif;">
            <h2 style="color: red;">⚠️ Security Alert Detected</h2>
            <table style="border-collapse: collapse; width: 100%;">
                <tr><td><strong>Severity:</strong></td><td>{severity}</td></tr>
                <tr><td><strong>Type:</strong></td><td>{finding_type}</td></tr>
                <tr><td><strong>Time:</strong></td><td>{datetime.now().isoformat()}</td></tr>
            </table>
            <h3>Description:</h3>
            <p>{description}</p>
            {self._format_metadata_table(metadata)}
            <hr>
            <p style="color: #666; font-size: 12px;">Sent by Security Audit System</p>
