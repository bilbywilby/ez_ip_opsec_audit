#!/usr/bin/env python3
"""
Multi-channel alert notification system
Supports email, Slack, webhook, and SMS notifications
"""

import smtplib
import requests
import json
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from typing import Dict, List, Optional
from dataclasses import dataclass
from datetime import datetime
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

@dataclass
class AlertConfig:
    channels: List[str]  # ['email', 'slack', 'webhook']
    severity_threshold: str  # 'CRITICAL', 'HIGH', 'MEDIUM', 'LOW'
    cooldown_minutes: int = 15  # Prevent alert spam
    recipients: Dict[str, list] = None  # {'email': [], 'slack_webhooks': []}

class AlertNotifier:
    def __init__(self, config: AlertConfig):
        self.config = config
        self._last_alert_time = {}
    
    def should_send_alert(self, alert_key: str) -> bool:
        """Rate limit alerts to prevent notification storms"""
        if alert_key not in self._last_alert_time:
            return True
        
        elapsed = datetime.now() - self._last_alert_time[alert_key]
        if elapsed.total_seconds() > self.config.cooldown_minutes * 60:
            del self._last_alert_time[alert_key]
            return True
        
        return False
    
    def send_alert(self, severity: str, finding_type: str, description: str, 
                   metadata: Dict = None) -> bool:
        """Send alert through configured channels"""
        if severity not in ['CRITICAL', 'HIGH']:
            # Skip below threshold unless explicitly configured
            if self.config.severity_threshold == 'MEDIUM':
                pass
            elif self.config.severity_threshold == 'LOW':
                pass
            else:
                logger.info(f"Skipping {severity} alert - below threshold")
                return False
        
        alert_key = f"{severity}_{finding_type}"
        if not self.should_send_alert(alert_key):
            logger.info(f"Alert rate-limited: {alert_key}")
            return False
        
        success = True
        
        # Email notification
        if 'email' in self.config.channels:
            success &= self._send_email(severity, finding_type, description, metadata)
        
        # Slack notification
        if 'slack' in self.config.channels:
            success &= self._send_slack(severity, finding_type, description, metadata)
        
        # Generic webhook
        if 'webhook' in self.config.channels:
            success &= self._send_webhook(severity, finding_type, description, metadata)
        
        if success:
            self._last_alert_time[alert_key] = datetime.now()
        
        return success
    
    def _send_email(self, severity: str, finding_type: str, description: str, 
                    metadata: Dict) -> bool:
        """Send SMTP email alert"""
        try:
            smtp_config = {
                'server': os.getenv('SMTP_SERVER', 'smtp.gmail.com'),
                'port': int(os.getenv('SMTP_PORT', 587)),
                'username': os.getenv('SMTP_USERNAME'),
                'password': os.getenv('SMTP_PASSWORD'),
                'from_addr': os.getenv('ALERT_FROM_EMAIL'),
                'to_addrs': self.config.recipients.get('email', [])
            }
            
            if not all([smtp_config['username'], smtp_config['password']]):
                logger.warning("Email credentials not configured")
                return False
            
            subject = f"🚨 SECURITY ALERT: [{severity}] {finding_type}"
            body = self._format_email_body(severity, finding_type, description, metadata)
            
            msg = MIMEMultipart()
            msg['From'] = smtp_config['from_addr']
            msg['To'] = ', '.join(smtp_config['to_addrs'])
            msg['Subject'] = subject
            msg.attach(MIMEText(body, 'html'))
            
            server = smtplib.SMTP(smtp_config['server'], smtp_config['port'])
            server.starttls()
            server.login(smtp_config['username'], smtp_config['password'])
            server.send_message(msg)
            server.quit()
            
            logger.info(f"Email alert sent: {severity} - {finding_type}")
            return True
            
        except Exception as e:
            logger.error(f"Email alert failed: {e}")
            return False
    
    def _send_slack(self, severity: str, finding_type: str, description: str, 
                    metadata: Dict) -> bool:
        """Send Slack webhook notification"""
        try:
            slack_configs = self.config.recipients.get('slack_webhooks', [])
            
            colors = {
                'CRITICAL': '#ff0000',
                'HIGH': '#ff9900',
                'MEDIUM': '#ffcc00',
                'LOW': '#00cc00'
            }
            
            payload = {
                "attachments": [{
                    "color": colors.get(severity, '#cccccc'),
                    "title": f"Security Audit Alert: {finding_type}",
                    "text": description,
                    "fields": [
                        {"title": "Severity", "value": severity, "short": True},
                        {"title": "Detected", "value": datetime.now().isoformat(), "short": True},
                    ],
                    "footer": "Security Audit System",
                    "ts": int(datetime.now().timestamp())
                }]
            }
            
            if metadata:
                payload["attachments"][0]["fields"].extend([
                    {"title": k.capitalize(), "value": str(v), "short": True}
                    for k, v in list(metadata.items())[:4]
                ])
            
            for webhook_url in slack_configs:
                response = requests.post(
                    webhook_url,
                    json=payload,
                    timeout=10
                )
                response.raise_for_status()
            
            logger.info(f"Slack alert sent: {severity} - {finding_type}")
            return True
            
        except Exception as e:
            logger.error(f"Slack alert failed: {e}")
            return False
    
    def _send_webhook(self, severity: str, finding_type: str, description: str,
