#!/usr/bin/env python3
"""
Production configuration management
Secure credential handling via environment variables
"""

import os
from dataclasses import dataclass
from pathlib import Path
from typing import Optional, List

@dataclass
class DatabaseConfig:
    path: str = "/tmp/security_audit.db"
    pool_size: int = 5
    timeout: int = 30

@dataclass
class LoggingConfig:
    level: str = "INFO"
    directory: str = "/var/log/security-audit"
    retention_days: int = 90
    max_file_size_mb: int = 100

@dataclass
class AlertConfig:
    enabled: bool = True
    channels: List[str] = None  # ['email', 'slack', 'webhook']
    severity_threshold: str = "HIGH"
    cooldown_minutes: int = 15

@dataclass
class ServerConfig:
    host: str = "0.0.0.0"
    port: int = 5000
    debug: bool = False
    workers: int = 4
    threads: int = 2

class ConfigManager:
    def __init__(self, env_file: Optional[str] = None):
        self.env_file = env_file
        self._load_env()
    
    def _load_env(self):
        """Load environment variables from .env file if exists"""
        if self.env_file and os.path.exists(self.env_file):
            from dotenv import load_dotenv
            load_dotenv(self.env_file)
    
    @property
    def database(self) -> DatabaseConfig:
        return DatabaseConfig(
            path=os.getenv('DATABASE_PATH', '/tmp/security_audit.db'),
            pool_size=int(os.getenv('DB_POOL_SIZE', 5)),
            timeout=int(os.getenv('DB_TIMEOUT', 30))
        )
    
    @property
    def logging(self) -> LoggingConfig:
        return LoggingConfig(
            level=os.getenv('LOG_LEVEL', 'INFO'),
            directory=os.getenv('LOG_DIR', '/var/log/security-audit'),
            retention_days=int(os.getenv('LOG_RETENTION_DAYS', 90)),
            max_file_size_mb=int(os.getenv('MAX_LOG_SIZE_MB', 100))
        )
    
    @property
    def alerts(self) -> AlertConfig:
        channels_str = os.getenv('ALERT_CHANNELS', '')
        channels = [c.strip() for c in channels_str.split(',') if c.strip()]
        
        return AlertConfig(
            enabled=os.getenv('ALERTS_ENABLED', 'true').lower() == 'true',
            channels=channels if channels else ['email'],
            severity_threshold=os.getenv('ALERT_SEVERITY_THRESHOLD', 'HIGH'),
            cooldown_minutes=int(os.getenv('ALERT_COOLDOWN_MINUTES', 15))
        )
    
    @property
    def server(self) -> ServerConfig:
        return ServerConfig(
            host=os.getenv('SERVER_HOST', '0.0.0.0'),
            port=int(os.getenv('SERVER_PORT', 5000)),
            debug=os.getenv('FLASK_DEBUG', 'false').lower() == 'true',
            workers=int(os.getenv('GUNICORN_WORKERS', 4)),
            threads=int(os.getenv('GUNICORN_THREADS', 2))
        )
    
    def validate(self) -> List[str]:
        """Validate configuration requirements"""
        errors = []
        
        if not self.alerts.enabled:
            return errors
        
        if 'email' in self.alerts.channels:
            if not all([
                os.getenv('SMTP_SERVER'),
                os.getenv('SMTP_USERNAME'),
                os.getenv('SMTP_PASSWORD'),
                os.getenv('ALERT_FROM_EMAIL')
            ]):
                errors.append("Email alerts enabled but SMTP credentials incomplete")
        
        if 'webhook' in self.alerts.channels:
            if not os.getenv('ALERT_WEBHOOK_URL'):
                errors.append("Webhook alerts enabled but ALERT_WEBHOOK_URL not set")
        
        if 'slack' in self.alerts.channels:
            slack_urls = os.getenv('SLACK_WEBHOOK_URLS', '')
            if not slack_urls.strip():
                errors.append("Slack alerts enabled but SLACK_WEBHOOK_URLS not set")
        
        return errors
