        rows = "".join([
            f"<tr><td><strong>{k}:</strong></td><td>{v}</td></tr>"
            for k, v in metadata.items()
        ])
        
        return f"""
        <h3>Additional Details:</h3>
        <table style="border-collapse: collapse; width: 100%;">
