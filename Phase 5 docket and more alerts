#!/usr/bin/env python3
"""
Dynamic alert rule engine for correlating findings
Detects patterns that indicate systemic issues
"""

from typing import Dict, List, Any
from datetime import datetime, timedelta
import sqlite3
from collections import defaultdict

class AlertRuleEngine:
    def __init__(self, db_path: str):
        self.db_path = db_path
    
    def evaluate_rules(self, findings: List[Dict]) -> List[Dict]:
        """Evaluate all alert rules against new findings"""
        triggered_rules = []
        
        # Rule 1: Multiple critical findings in short timeframe
        critical_finding = self._check_critical_spike(findings)
        if critical_finding:
            triggered_rules.append(critical_finding)
        
        # Rule 2: Same finding type recurring
        recurrence = self._check_recurrence(findings)
        if recurrence:
            triggered_rules.append(recurrence)
        
        # Rule 3: Escalating severity pattern
        escalation = self._check_severity_escalation(findings)
        if escalation:
            triggered_rules.append(escalation)
        
        # Rule 4: Threshold breach (total findings per audit)
        threshold_breach = self._check_threshold_breach(findings)
        if threshold_breach:
            triggered_rules.append(threshold_breach)
        
        return triggered_rules
    
    def _check_critical_spike(self, findings: List[Dict], window_minutes: int = 30,
                              count_threshold: int = 3) -> Optional[Dict]:
        """Detect multiple critical findings in rapid succession"""
        critical_findings = [f for f in findings if f.get('severity') == 'CRITICAL']
        
        if len(critical_findings) >= count_threshold:
            return {
                'rule': 'critical_spike',
                'severity': 'CRITICAL',
                'title': f'Multiple Critical Findings Detected ({len(critical_findings)} in {window_minutes} min)',
                'message': f'{count_threshold}+ critical issues found simultaneously',
                'findings': critical_findings,
                'recommended_action': 'Immediate investigation required'
            }
        return None
    
    def _check_recurrence(self, findings: List[Dict], lookback_days: int = 7,
                          recurrence_threshold: int = 3) -> Optional[Dict]:
        """Detect recurring findings indicating unresolved issues"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cutoff = (datetime.now() - timedelta(days=lookback_days)).strftime('%Y-%m-%d')
        
        for finding in findings:
            finding_type = finding.get('type')
            
            cursor.execute("""
                SELECT COUNT(*) FROM findings f
                JOIN audit_cycles a ON f.audit_id = a.id
                WHERE f.type = ? AND DATE(a.timestamp) >= ?
            """, (finding_type, cutoff))
            
            count = cursor.fetchone()[0]
            
            if count >= recurrence_threshold:
                return {
                    'rule': 'recurrence',
                    'severity': 'HIGH',
                    'title': f'Recurring Finding: {finding_type}',
                    'message': f'Issue detected {count} times in past {lookback_days} days',
                    'finding_type': finding_type,
                    'recommended_action': 'Address root cause instead of symptoms'
                }
        
        conn.close()
        return None
    
    def _check_severity_escalation(self, findings: List[Dict]) -> Optional[Dict]:
        """Detect if issue severity is trending upward"""
        # Compare current audit with previous
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute("SELECT id FROM audit_cycles ORDER BY timestamp DESC LIMIT 2")
        audits = cursor.fetchall()
        
        if len(audits) < 2:
            conn.close()
            return None
        
        current_id, prev_id = audits[0][0], audits[1][0]
        
        cursor.execute("""
            SELECT severity, COUNT(*) FROM findings WHERE audit_id = ? GROUP BY severity
        """, (current_id,))
        current_counts = dict(cursor.fetchall())
        
        cursor.execute("""
            SELECT severity, COUNT(*) FROM findings WHERE audit_id = ? GROUP BY severity
        """, (prev_id,))
        prev_counts = dict(cursor.fetchall())
        
        # Check if critical/high increased
        critical_increase = current_counts.get('CRITICAL', 0) > prev_counts.get('CRITICAL', 0)
        high_increase = current_counts.get('HIGH', 0) > prev_counts.get('HIGH', 0)
        
        if critical_increase or high_increase:
            return {
                'rule': 'escalation',
                'severity': 'HIGH',
                'title': 'Severity Escalation Detected',
                'message': f'Critical: +{current_counts.get("CRITICAL",0)-prev_counts.get("CRITICAL",0)}, High: +{current_counts.get("HIGH",0)-prev_counts.get("HIGH",0)}',
                'recommended_action': 'Review recent changes that may have introduced new issues'
            }
        
        conn.close()
        return None
    
    def _check_threshold_breach(self, findings: List[Dict], 
                                total_threshold: int = 50) -> Optional[Dict]:
        """Alert when total findings exceed organizational threshold"""
        if len(findings) >= total_threshold:
            return {
                'rule': 'threshold_breach',
                'severity': 'MEDIUM',
                'title': f'Finding Threshold Exceeded ({len(findings)} findings)',
                'message': 'Total findings exceeded configured threshold',
                'recommendation': 'Consider scheduling more frequent audits or increasing remediation capacity'
            }
        return None
